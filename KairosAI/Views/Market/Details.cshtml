@model KairosAI.Models.ViewModels.AssetDetailViewModel
@{
    ViewData["Title"] = $"Análisis de {Model.Name} ({Model.Symbol})";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var changeClass = Model.Change24h >= 0 ? "text-emerald-500" : "text-red-500";
    var changeSign = Model.Change24h >= 0 ? "+" : "";

    var sentimentColor = Model.KairosSentiment?.ToLower() switch
    {
        "alcista" => "color: #10b981; border-color: rgba(16,185,129,0.3); background: rgba(16,185,129,0.1);",
        "bajista" => "color: #ef4444; border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.1);",
        _ => "color: #06b6d4; border-color: rgba(6,182,212,0.3); background: rgba(6,182,212,0.1);"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/Market/Details.css" asp-append-version="true" />
}
<div class="w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">

    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors mb-6 font-medium no-underline">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver al Mercado
    </a>

    <div class="glass-panel flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6 k-fade">
        <div class="flex items-center gap-4">

            <div class="asset-logo-wrap">
                <img src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "invalid")"
                     alt="@Model.Symbol"
                     onerror="handleLogoError(this, '@Model.Symbol')" />
                <span class="hidden w-full h-full flex items-center justify-center font-mono font-bold text-xl text-[var(--text-muted)]">
                    @Model.Symbol.Substring(0, 1)
                </span>
            </div>

            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold tracking-tight text-[var(--text-main)]">@Model.Name</h1>
                    <span class="px-2.5 py-1 rounded-md text-[var(--text-muted)] font-mono text-xs font-semibold border border-[var(--border-color)] bg-[var(--bg-panel)]">@Model.Symbol</span>
                    @if (Model.IsTrending)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-orange-500/10 text-orange-500 text-[0.65rem] font-bold border border-orange-500/20 flex items-center gap-1">
                            <i data-lucide="flame" class="w-3 h-3"></i> HOT
                        </span>
                    }
                </div>
                <p class="text-sm text-[var(--text-muted)] mt-1">Riesgo evaluado: <span class="font-semibold text-[var(--text-main)]">@Model.RiskLevel</span></p>
            </div>
        </div>

        <div class="text-left md:text-right flex flex-col justify-center">
            <div class="text-3xl font-mono font-bold tracking-tight tabular-nums text-[var(--text-main)]">$@Model.Price.ToString("N2")</div>
            <div class="text-sm font-mono font-semibold @changeClass mt-1 flex items-center md:justify-end gap-1">
                <i data-lucide="@(Model.Change24h >= 0 ? "trending-up" : "trending-down")" class="w-4 h-4"></i>
                @changeSign@Model.Change24h.ToString("F2")% (24h)
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-2 space-y-6">
            <div class="glass-panel k-fade" style="animation-delay: 0.1s;">
                <h3 class="text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4">Evolución de Precio</h3>
                <div class="w-full h-[300px] relative">
                    <canvas id="assetChart"></canvas>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 k-fade" style="animation-delay: 0.15s;">
                <div class="stat-box">
                    <p class="text-[0.65rem] text-[var(--text-muted)] uppercase tracking-wider mb-1 font-bold">Cap. de Mercado</p>
                    <p class="font-mono text-sm font-semibold text-[var(--text-main)] tabular-nums">@(!string.IsNullOrEmpty(Model.MarketCap) ? Model.MarketCap : "N/D")</p>
                </div>
                <div class="stat-box">
                    <p class="text-[0.65rem] text-[var(--text-muted)] uppercase tracking-wider mb-1 font-bold">Volumen (24h)</p>
                    <p class="font-mono text-sm font-semibold text-[var(--text-main)] tabular-nums">@(!string.IsNullOrEmpty(Model.Volume24h) ? Model.Volume24h : "N/D")</p>
                </div>
                <div class="stat-box">
                    <p class="text-[0.65rem] text-[var(--text-muted)] uppercase tracking-wider mb-1 font-bold">Máx (24h)</p>
                    <p class="font-mono text-sm font-semibold text-emerald-500 tabular-nums">$@Model.High24h.ToString("N2")</p>
                </div>
                <div class="stat-box">
                    <p class="text-[0.65rem] text-[var(--text-muted)] uppercase tracking-wider mb-1 font-bold">Mín (24h)</p>
                    <p class="font-mono text-sm font-semibold text-red-500 tabular-nums">$@Model.Low24h.ToString("N2")</p>
                </div>
            </div>
        </div>

        <div class="space-y-6">

            <div class="ai-glow-panel p-6 k-fade" style="animation-delay: 0.2s;">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4 text-[#7c3aed]"></i>
                        <h2 class="font-bold text-[var(--text-main)] text-sm tracking-wide">Análisis KairósAI</h2>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.KairosSentiment))
                    {
                        <span class="px-2.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider rounded-full border" style="@sentimentColor">
                            @Model.KairosSentiment
                        </span>
                    }
                </div>

                <div class="text-[0.8rem] text-[var(--text-main)] opacity-90 leading-relaxed font-medium">
                    @if (!string.IsNullOrEmpty(Model.KairosAnalysis))
                    {
                        @Html.Raw(Model.KairosAnalysis.Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <p class="italic text-[var(--text-muted)]">Recopilando datos... Solicita un análisis en el chat.</p>
                    }
                </div>
            </div>

            <div class="glass-panel k-fade" style="animation-delay: 0.25s;">
                <h3 class="text-sm font-bold text-[var(--text-main)] mb-4">Operar @Model.Symbol</h3>
                <form class="space-y-4">
                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-[0.65rem] uppercase tracking-wider text-[var(--text-muted)] font-bold">Monto a Invertir</label>
                            <span class="text-xs font-mono text-[var(--text-muted)]">Saldo: $450.00</span>
                        </div>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)] font-mono">$</span>
                            <input type="number" asp-for="AmountToInvest" class="input-theme w-full rounded-xl py-3 pl-8 pr-4 font-mono text-lg font-bold focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] outline-none transition-all" placeholder="0.00">
                        </div>
                    </div>
                    <button type="button" class="w-full py-3.5 rounded-xl font-bold text-white transition-all bg-gradient-to-r from-[#7c3aed] to-[#06b6d4] hover:opacity-90 shadow-[0_4px_20px_rgba(124,58,237,0.3)] hover:-translate-y-0.5">
                        Previsualizar Orden
                    </button>
                    <p class="text-[0.6rem] text-[var(--text-muted)] text-center uppercase tracking-widest mt-3 flex items-center justify-center gap-1">
                        <i data-lucide="lock" class="w-3 h-3"></i> Protegido por Kairós
                    </p>
                </form>
            </div>

            <div class="glass-panel k-fade" style="animation-delay: 0.3s;">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-sm font-bold flex items-center gap-2 text-[var(--text-main)]">
                        <i data-lucide="layers" class="w-4 h-4 text-blue-500"></i> Mercado Hoy
                    </h2>
                </div>

                <div class="flex flex-col flex-1 overflow-y-auto pr-1 custom-scroll" style="max-height: 340px;">
                    @foreach (var asset in Model.TopAssets)
                    {
                        <a href="#" class="flex items-center justify-between py-3 px-2 rounded-xl hover:bg-white/5 transition-colors border-b border-white/5 last:border-0 no-underline">
                            <div class="flex items-center gap-3">
                                <img src="@(!string.IsNullOrEmpty(asset.ImageUrl) ? asset.ImageUrl : "invalid")"
                                     class="w-8 h-8 rounded-full object-cover bg-black/20"
                                     alt="@asset.Symbol"
                                     onerror="handleListLogoError(this, '@asset.Symbol')" />

                                <div class="fallback-icon hidden w-8 h-8 rounded-full border border-[var(--border-color)] items-center justify-center font-bold text-xs font-mono bg-[var(--bg-panel)] text-[var(--text-main)]">
                                    @asset.Symbol.Substring(0, 1)
                                </div>

                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-[var(--text-main)] leading-tight">@asset.Symbol</span>
                                    <span class="text-xs text-[var(--text-muted)] truncate w-20">@asset.Name</span>
                                </div>
                            </div>
                            <div class="text-right flex flex-col">
                                <span class="text-[0.85rem] font-bold text-[var(--text-main)] tabular-nums font-mono">$@asset.Price.ToString("N2")</span>
                                <span class="text-xs font-bold @(asset.Change24h >= 0 ? "text-emerald-500" : "text-red-500")">
                                    @(asset.Change24h >= 0 ? "▲" : "▼") @Math.Abs(asset.Change24h).ToString("F2")%
                                </span>
                            </div>
                        </a>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/Market/Details.js" asp-append-version="true"></script>
    
}