@model KairosAI.Models.ViewModels.MarketIndexViewModel
@{
    ViewData["Title"] = "Mercado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HEADER SUPERIOR -->
<header class="h-20 border-b border-gray-800 flex items-center justify-between px-6 bg-kairos-dark/80 backdrop-blur-md z-20">
    <div>
        <h1 class="text-2xl font-bold text-white">Mercado</h1>
        <p class="text-sm text-gray-400">Explora activos, tendencias y análisis de KairosAI</p>
    </div>
</header>

<div class="p-6 space-y-6">

    <!-- BUSCADOR + FILTROS -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">

        <!-- BUSCADOR -->
        <form asp-controller="Market" asp-action="Index" method="get" class="flex items-center gap-3 w-full md:w-1/3">
            <input type="text"
                   name="search"
                   value="@Model.SearchTerm"
                   placeholder="Buscar activo: BTC, ETH, NVDA..."
                   class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-gray-700 text-gray-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </form>

        <!-- FILTROS -->
        <div class="flex items-center gap-2">
            @{
                string[] filtros = { "Todos", "Cripto", "Accion", "ETF" };
            }

            @foreach (var f in filtros)
            {
                <a asp-controller="Market" asp-action="Index" asp-route-filter="@f"
                   class="px-4 py-2.5 rounded-lg text-sm transition-all
                       @(Model.Filter == f
                                           ? "bg-blue-600 text-white"
                                           : "bg-white/5 text-gray-300 hover:bg-white/10")">
                @f
            </a>
                        }
        </div>
    </div>

    <!-- TABLA DE ACTIVOS -->
    <div class="overflow-hidden rounded-xl bg-white/5 border border-gray-800 backdrop-blur-md shadow-xl">
        <table class="w-full text-left">
            <thead class="bg-white/5 border-b border-gray-800 text-gray-400 text-sm uppercase">
                <tr>
                    <th class="px-6 py-4">Activo</th>
                    <th class="px-6 py-4">Precio</th>
                    <th class="px-6 py-4">24h</th>
                    <th class="px-6 py-4">Riesgo</th>
                    <th class="px-6 py-4">Tipo</th>
                    <th class="px-6 py-4 text-right">Acción</th>
                </tr>
            </thead>
            <tbody class="text-gray-200">

                @foreach (var asset in Model.Assets)
                {
                    var changeColor = asset.Change24h > 0 ? "text-green-400" : "text-red-400";
                    var riskColor = asset.RiskLevel switch
                    {
                        "Bajo" => "text-green-400",
                        "Medio" => "text-yellow-400",
                        "Alto" => "text-orange-400",
                        "Extremo" => "text-red-500",
                        _ => "text-gray-300"
                    };
                    <tr class="border-b border-gray-800 hover:bg-white/5 transition">
                        <td class="px-6 py-4 flex items-center gap-2">
                            <span class="font-semibold">@asset.Symbol</span>
                            <span class="text-gray-400 text-sm">@asset.Name</span>

                            @if (asset.IsTrending)
                            {
                                <span class="text-red-500 ml-2" title="Tendencia">
                                    <i data-lucide="flame" size="16"></i>
                                </span>
                            }
                        </td>

                        <td class="px-6 py-4">
                            $@asset.Price
                        </td>

                        <td class="px-6 py-4">
                            <span class="@changeColor">
                                @(asset.Change24h > 0 ? "+" : "")@asset.Change24h%
                            </span>
                        </td>

                        <td class="px-6 py-4">
                            <span class="@riskColor">@asset.RiskLevel</span>
                        </td>

                        <td class="px-6 py-4">
                            @asset.Type
                        </td>

                        <td class="px-6 py-4 text-right">
                            <a asp-controller="Market" asp-action="Details" asp-route-id="@asset.Symbol"
                               class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg text-white text-sm transition">
                                Ver más
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
