@model KairosAI.Models.ViewModels.RewardsIndexViewModel
@{
    ViewData["Title"] = "Recompensas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/rewards/index.css" asp-append-version="true" />
}

<div class="rewards-page">

    <!-- Ambient -->
    <div class="ambient-blob ambient-blob--main"></div>

    <!-- ── HEADER ── -->
    <header class="rewards-header sticky top-0 z-20 px-4 sm:px-8 py-4 k-fade">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">

            <div class="flex items-center gap-3">
                <div class="header-icon-box">
                    <i data-lucide="gift" class="icon-gold-sm"></i>
                </div>
                <div>
                    <h1 class="rewards-title">
                        Recompensas
                    </h1>
                    <p class="rewards-subtitle">
                        Invierte, aprende y canjea beneficios reales
                    </p>
                </div>
            </div>

            <!-- Points badge -->
            <div class="points-badge">
                <div class="points-icon">
                    <i data-lucide="coins"></i>
                </div>
                <div>
                    <p class="points-label">Saldo disponible</p>
                    <p class="points-value">
                        @Model.UserPoints <span>pts</span>
                    </p>
                </div>
            </div>

        </div>
    </header>

    <div class="px-4 sm:px-8 pt-6 max-w-6xl mx-auto relative z-10">

        <!-- ── SUCCESS MSG ── -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-box k-fade mb-5">
                <i data-lucide="check-circle" class="success-icon"></i>
                <span class="success-text">@TempData["SuccessMessage"]</span>
            </div>
        }

        <!-- ── TIER PROGRESS ── -->
        <div class="tier-wrapper k-fade mb-6">
            <div class="tier-card">

                <div class="tier-header">
                    <div class="tier-level">
                        <span class="tier-label">Nivel</span>
                        <span class="tier-badge">
                            @(Model.UserPoints >= 5000 ? "GOLD" : Model.UserPoints >= 2000 ? "SILVER" : "BRONZE")
                        </span>
                    </div>

                    <span class="tier-next">
                        @Model.UserPoints /
                        @(Model.UserPoints >= 5000 ? "∞" : Model.UserPoints >= 2000 ? "5000" : "2000")
                        pts para siguiente nivel
                    </span>
                </div>

                <div class="tier-progress-wrapper">
                    <div class="tier-track">
                        <div class="tier-fill"
                             id="tierFill"
                             data-target="@(Model.UserPoints >= 5000 ? 100 : Model.UserPoints >= 2000 ? (int)((Model.UserPoints - 2000.0) / 3000 * 100) : (int)(Model.UserPoints / 2000.0 * 100))">
                        </div>
                    </div>

                    <span class="tier-percent">
                        @(Model.UserPoints >= 5000
                                                ? "MAX"
                                                : Model.UserPoints >= 2000
                                                ? ((int)((Model.UserPoints - 2000.0) / 3000 * 100)) + "%"
                                                : (int)(Model.UserPoints / 2000.0 * 100) + "%")
                    </span>
                </div>
            </div>
        </div>

        <!-- ── FILTER PILLS ── -->
        <div class="filter-container k-fade mb-6" id="filterContainer">
            <button class="filter-pill active" data-filter="all">
                <i data-lucide="layout-grid"></i> Todo
            </button>
            <button class="filter-pill" data-filter="streaming">
                <i data-lucide="play-circle"></i> Streaming
            </button>
            <button class="filter-pill" data-filter="shopping">
                <i data-lucide="shopping-bag"></i> Compras
            </button>
            <button class="filter-pill" data-filter="gaming">
                <i data-lucide="gamepad-2"></i> Gaming
            </button>
            <button class="filter-pill" data-filter="kairos">
                <i data-lucide="sparkles"></i> KairosAI
            </button>
        </div>

        <!-- ── REWARD CARDS ── -->
        <div class="k-fade">
            <div id="rewardsGrid" class="rewards-grid">

                @foreach (var reward in Model.Rewards)
                {
                    var canAfford = reward.CanAfford(Model.UserPoints);
                    int pct = canAfford ? 100 : (int)Math.Min(100, (Model.UserPoints / (double)reward.Cost) * 100);

                    string gradient = "gradient-kairos";
                    string logoUrl = "";
                    string category = "kairos";
                    bool isNew = false;

                    var t = reward.Title.ToLower();

                    if (t.Contains("amazon"))
                    {
                        gradient = "gradient-amazon";
                        logoUrl = "https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg";
                        category = "shopping";
                    }
                    else if (t.Contains("google"))
                    {
                        gradient = "gradient-google";
                        logoUrl = "https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_Play_2022_icon.svg";
                        category = "shopping";
                        isNew = true;
                    }
                    else if (t.Contains("spotify"))
                    {
                        gradient = "gradient-spotify";
                        logoUrl = "https://upload.wikimedia.org/wikipedia/commons/1/19/Spotify_logo_without_text.svg";
                        category = "streaming";
                    }
                    else if (t.Contains("netflix"))
                    {
                        gradient = "gradient-netflix";
                        logoUrl = "https://upload.wikimedia.org/wikipedia/commons/0/08/Netflix_2015_logo.svg";
                        category = "streaming";
                    }
                    else if (t.Contains("steam"))
                    {
                        gradient = "gradient-steam";
                        logoUrl = "https://upload.wikimedia.org/wikipedia/commons/8/83/Steam_icon_logo.svg";
                        category = "gaming";
                    }

                    <div class="reward-card @(canAfford ? "" : "locked")"
                         data-category="@category">

                        <!-- Banner -->
                        <div class="card-banner @gradient">

                            @if (!string.IsNullOrEmpty(logoUrl))
                            {
                                <img src="@logoUrl" alt="@reward.Title" class="banner-logo" />
                            }
                            else
                            {
                                <i data-lucide="@reward.Icon" class="banner-icon"></i>
                            }

                            <div class="cost-pill">
                                <i data-lucide="coins"></i>
                                @reward.Cost pts
                            </div>

                            @if (isNew)
                            {
                                <div class="new-badge">NEW</div>
                            }
                        </div>

                        <!-- Body -->
                        <div class="card-body">

                            <h2 class="reward-title">
                                @reward.Title
                            </h2>

                            <p class="reward-description">
                                @reward.Description
                            </p>

                            @if (!canAfford)
                            {
                                <div class="points-wrapper">
                                    <div class="points-header">
                                        <span>Tu progreso</span>
                                        <span>@Model.UserPoints / @reward.Cost</span>
                                    </div>
                                    <div class="points-progress">
                                        <div class="points-progress-fill"
                                             style="width:@pct%;">
                                        </div>
                                    </div>
                                </div>
                            }

                            <form asp-action="Redeem" method="post">
                                <input type="hidden" name="id" value="@reward.Id" />

                                <button type="submit"
                                        class="btn-redeem @(canAfford ? "can" : "cant")"
                                        @(canAfford ? "" : "disabled aria-disabled='true'")>

                                    @if (canAfford)
                                    {
                                        <i data-lucide="gift"></i>
                                        <span>Canjear ahora</span>
                                    }
                                    else
                                    {
                                        <i data-lucide="lock"></i>
                                        <span>Faltan @(reward.Cost - Model.UserPoints) pts</span>
                                    }

                                </button>
                            </form>

                        </div>
                    </div>
                }

            </div>
        </div>

        <!-- ── CTA ── -->
        <div class="earn-more-wrapper k-fade mt-8">
            <div class="earn-more-card">

                <div class="earn-more-left">
                    <div class="earn-icon-box">
                        <i data-lucide="zap"></i>
                    </div>
                    <div>
                        <p class="earn-title">¿Quieres ganar más puntos?</p>
                        <p class="earn-subtitle">
                            Completa lecciones en Academia o consulta a KairosAI
                        </p>
                    </div>
                </div>

                <div class="earn-actions">
                    <a asp-controller="Education"
                       asp-action="Index"
                       class="cta-btn-outline">
                        Academia
                    </a>

                    <a asp-controller="Kairos"
                       asp-action="Index"
                       class="cta-btn-primary">
                        Chat con Kairos
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/rewards/index.js" asp-append-version="true"></script>
}