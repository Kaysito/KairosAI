@model KairosAI.Models.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "KairosAI Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Efecto de fondo "Nebulosa" sutil para el chat */
    .chat-bg-nebula {
        background: radial-gradient(circle at 15% 50%, rgba(124, 58, 237, 0.08), transparent 25%), radial-gradient(circle at 85% 30%, rgba(59, 130, 246, 0.08), transparent 25%);
        animation: pulseNebula 8s ease-in-out infinite alternate;
    }

    @@keyframes pulseNebula {
        0% {
            opacity: 0.5;
            transform: scale(1);
        }

        100% {
            opacity: 1;
            transform: scale(1.1);
        }
    }

    /* Scrollbar invisible para el contenedor de chat, pero funcional */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Animación de entrada de mensajes */
    .message-enter {
        animation: slideInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Efecto Glow en el Input al enfocar */
    .input-glow:focus-within {
        box-shadow: 0 0 20px rgba(124, 58, 237, 0.2);
        border-color: rgba(124, 58, 237, 0.5);
    }
</style>

<div class="flex flex-col h-[calc(100vh-2rem)] lg:h-[calc(100vh-3rem)] relative overflow-hidden rounded-3xl border border-kairos-border bg-kairos-bg shadow-2xl">

    <div class="absolute inset-0 chat-bg-nebula pointer-events-none z-0"></div>
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none z-0 mix-blend-overlay"
         style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>

    <header class="absolute top-0 left-0 right-0 h-16 flex items-center justify-between px-6 z-20 bg-kairos-card/70 backdrop-blur-md border-b border-white/5">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-gradient-to-tr from-violet-600 to-indigo-600 rounded-lg shadow-lg shadow-violet-500/20">
                <i data-lucide="sparkles" class="text-white w-5 h-5"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-kairos-main flex items-center gap-2">
                    Kairos IA
                    <span class="px-2 py-0.5 rounded-full bg-green-500/10 text-green-500 text-[10px] font-bold uppercase tracking-wider border border-green-500/20">Online</span>
                </h1>
                <p class="text-xs text-kairos-muted">Analista Financiero 24/7</p>
            </div>
        </div>

        <form asp-action="Clear" method="post">
            <button class="p-2 text-kairos-muted hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all tooltip-trigger" title="Limpiar conversación">
                <i data-lucide="trash-2" size="18"></i>
            </button>
        </form>
    </header>

    <div id="chatContainer" class="flex-1 overflow-y-auto px-4 sm:px-6 pt-20 pb-24 z-10 scroll-smooth space-y-6">

        @if (!Model.ConversationHistory.Any())
        {
            <div class="h-full flex flex-col items-center justify-center text-center opacity-0 animate-[fadeIn_0.8s_ease-out_forwards]">
                <div class="w-20 h-20 bg-gradient-to-b from-kairos-purple/20 to-transparent rounded-full flex items-center justify-center mb-6 border border-kairos-purple/20 shadow-[0_0_30px_rgba(124,58,237,0.15)]">
                    <i data-lucide="bot" class="w-10 h-10 text-kairos-purple"></i>
                </div>
                <h2 class="text-2xl font-bold text-kairos-main mb-2">¿Qué analizamos hoy?</h2>
                <p class="text-kairos-muted max-w-md mb-8">
                    Puedo analizar tendencias de mercado, explicar conceptos cripto o revisar tu portafolio simulado.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-2xl">
                    <button onclick="fillInput('Analiza la tendencia de Bitcoin para esta semana')"
                            class="p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-kairos-purple/30 transition-all text-left group">
                        <div class="flex items-center gap-2 mb-1">
                            <i data-lucide="trending-up" class="w-4 h-4 text-green-400"></i>
                            <span class="text-sm font-semibold text-kairos-main group-hover:text-kairos-purple transition-colors">Tendencia Bitcoin</span>
                        </div>
                        <p class="text-xs text-kairos-muted">Análisis técnico corto plazo</p>
                    </button>

                    <button onclick="fillInput('Explícame qué es un ETF de Ethereum')"
                            class="p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-kairos-purple/30 transition-all text-left group">
                        <div class="flex items-center gap-2 mb-1">
                            <i data-lucide="book-open" class="w-4 h-4 text-blue-400"></i>
                            <span class="text-sm font-semibold text-kairos-main group-hover:text-kairos-purple transition-colors">Conceptos</span>
                        </div>
                        <p class="text-xs text-kairos-muted">Explicación simple de ETFs</p>
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var msg in Model.ConversationHistory)
            {
                var isAi = msg.Role == "Kairos";

                <div class="flex w-full @(isAi ? "justify-start" : "justify-end") message-enter">
                    <div class="flex max-w-[90%] md:max-w-[75%] gap-3 @(isAi ? "flex-row" : "flex-row-reverse")">

                        <div class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center border
                                            @(isAi ? "bg-kairos-card border-kairos-purple/30" : "bg-gradient-to-br from-violet-500 to-fuchsia-500 border-transparent")">
                            @if (isAi)
                            {
                                <i data-lucide="sparkles" class="w-4 h-4 text-kairos-purple"></i>
                            }
                            else
                            {

                                <i data-lucide="user" class="w-4 h-4 text-white"></i>
                            }
                    </div>

                    <div class="relative px-5 py-3.5 rounded-2xl shadow-sm text-sm leading-relaxed
                                        @(isAi
                                                                 ? "bg-kairos-card/80 backdrop-blur-sm border border-white/10 text-kairos-main rounded-tl-none"
                                                                 : "bg-gradient-to-r from-violet-600 to-indigo-600 text-white shadow-lg shadow-violet-500/10 rounded-tr-none")">

                            @if (isAi)
                            {
                                <div class="text-[10px] font-bold text-kairos-purple uppercase tracking-wider mb-1 flex items-center gap-1">
                                    Kairos
                                    @if (msg.IsWarning)
                                    {
                                        <span class="text-yellow-500 ml-1 flex items-center"><i data-lucide="alert-triangle" class="w-3 h-3 mr-0.5"></i> Nota</span>
                                    }
                                </div>
                            }

                            <div class="prose prose-invert prose-sm max-w-none">
                                @msg.Text
                            </div>

                            <span class="text-[9px] absolute bottom-1 right-3 opacity-60">
                                @msg.Timestamp.ToShortTimeString()
                            </span>
                        </div>
                    </div>
                </div>
            }
        }

        <div id="typingIndicator" class="hidden flex justify-start w-full pl-11">
            <div class="bg-kairos-card/50 border border-white/5 px-4 py-3 rounded-2xl rounded-tl-none flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-kairos-purple rounded-full animate-bounce"></span>
                <span class="w-1.5 h-1.5 bg-kairos-purple rounded-full animate-bounce delay-100"></span>
                <span class="w-1.5 h-1.5 bg-kairos-purple rounded-full animate-bounce delay-200"></span>
            </div>
        </div>

    </div>

    <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 bg-gradient-to-t from-kairos-bg via-kairos-bg/95 to-transparent z-20">
        <form asp-action="Send" method="post" class="max-w-4xl mx-auto relative input-glow rounded-2xl transition-all duration-300">

            <div class="relative bg-kairos-panel/80 backdrop-blur-xl border border-white/10 rounded-2xl flex items-end p-2 shadow-2xl">

                <button type="button" class="p-3 text-kairos-muted hover:text-kairos-main transition-colors rounded-xl hover:bg-white/5 h-[52px]">
                    <i data-lucide="paperclip" size="20"></i>
                </button>

                <textarea asp-for="CurrentInput"
                          id="chatInput"
                          rows="1"
                          placeholder="Pregunta sobre mercados, activos o predicciones..."
                          class="w-full bg-transparent border-none text-kairos-main placeholder-gray-500 focus:ring-0 resize-none py-3.5 max-h-32 text-sm scrollbar-hide"
                          oninput="autoResize(this)"
                          onkeydown="handleEnter(event)"></textarea>

                <button type="submit"
                        class="p-3 bg-kairos-purple hover:bg-purple-600 text-white rounded-xl shadow-lg shadow-purple-500/20 hover:shadow-purple-500/40 transition-all duration-200 hover:scale-105 h-[52px] w-[52px] flex items-center justify-center">
                    <i data-lucide="arrow-up" size="20" stroke-width="3"></i>
                </button>
            </div>

            <p class="text-center text-[10px] text-kairos-muted mt-2 opacity-60">
                KairosAI puede cometer errores. Verifica la información financiera importante.
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar Iconos
        if(typeof lucide !== 'undefined') lucide.createIcons();

        const chatContainer = document.getElementById('chatContainer');
        const chatInput = document.getElementById('chatInput');

        // 1. Auto-scroll al fondo
        function scrollToBottom() {
            if (chatContainer) {
                chatContainer.scrollTo({
                    top: chatContainer.scrollHeight,
                    behavior: 'smooth'
                });
            }
        }

        // Ejecutar al cargar
        scrollToBottom();

        // 2. Auto-resize del Textarea
        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
            // Limitar altura máxima visualmente si crece mucho (CSS max-h-32 ya lo hace)
        }

        // 3. Enviar con Enter (Shift+Enter para salto de línea)
        function handleEnter(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault(); // Evitar salto de línea
                if(e.target.value.trim() !== "") {
                    // Mostrar indicador de "Escribiendo..." visualmente
                    document.getElementById('typingIndicator')?.classList.remove('hidden');
                    scrollToBottom();
                    e.target.form.submit();
                }
            }
        }

        // 4. Llenar input desde sugerencias
        window.fillInput = function(text) {
            if(chatInput) {
                chatInput.value = text;
                chatInput.focus();
                autoResize(chatInput);
            }
        }

        // Enfocar al cargar
        chatInput?.focus();
    </script>
}