@model KairosAI.Models.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "KairosAI Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Kairos/Index.css" asp-append-version="true" />
}

<div class="k-app">

    @* ═══════════════════════════════════════════════════════════
       HEADER
       ═══════════════════════════════════════════════════════════ *@
    <header class="k-header">
        <div class="k-header__brand">
            <div class="k-header__logo">
                <i data-lucide="bot"></i>
            </div>
            <div>
                <div class="k-header__title">Kairos Intelligence</div>
                <div class="k-header__status">
                    <div class="live-dot"></div>
                    Modelo financiero activo
                </div>
            </div>
        </div>
        <div class="k-header__actions">
            <span class="k-header__version">v@(Model.AppVersion)</span>
            <form asp-action="Clear" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="act-btn"
                        title="Nueva conversación"
                        aria-label="Iniciar nueva conversación">
                    <i data-lucide="square-pen"></i>
                </button>
            </form>
        </div>
    </header>

    @* ═══════════════════════════════════════════════════════════
       MAIN CHAT AREA
       ═══════════════════════════════════════════════════════════ *@
    <main class="k-main">
        <div id="chatContainer" class="k-chat-scroll scroll-h">

            @if (!Model.ConversationHistory.Any())
            {
                @* ── Estado Vacío ── *@
                <div id="emptyState" class="k-empty k-fade-in">
                    <div class="k-empty__icon">
                        <i data-lucide="sparkles"></i>
                    </div>
                    <h2 class="k-empty__greeting">
                        Hola, @Model.UserDisplayName 👋
                    </h2>
                    <p class="k-empty__description">
                        Soy tu asesor financiero IA. Analizo portafolios,
                        explico conceptos DeFi y te ayudo a invertir
                        con más criterio.
                    </p>
                    <div class="k-suggestions">
                        @foreach (var chip in Model.SuggestionChips)
                        {
                            <button type="button"
                                    class="suggestion-chip"
                                    data-prompt="@chip.Prompt">
                                <span class="k-suggestion__category k-suggestion__category--@chip.CssModifier">
                                    @chip.Icon @chip.Label
                                </span>
                                @chip.DisplayText
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                @* ── Mensajes ── *@
                <div id="messagesWrapper" class="k-messages">
                    @foreach (var msg in Model.ConversationHistory)
                    {
                        @await Html.PartialAsync("_ChatMessage", msg)
                    }
                </div>
            }

            @* ── Indicador de escritura ── *@
            <div id="typingIndicator"
                 class="k-typing hidden"
                 aria-live="polite"
                 aria-label="Kairos está escribiendo">
                <div class="k-typing__inner">
                    <div class="avatar-ai">
                        <i data-lucide="bot"></i>
                    </div>
                    <div class="k-typing__dots">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ═══════════════════════════════════════════════════════
           INPUT BAR
           ═══════════════════════════════════════════════════════ *@
        <div class="k-input-area input-fade">
            <form id="chatForm" class="k-input-form">
                @Html.AntiForgeryToken()
                <div class="chat-input-box k-input-row">
                    <button type="button"
                            class="act-btn"
                            title="Adjuntar archivo (próximamente)"
                            aria-label="Adjuntar archivo"
                            disabled>
                        <i data-lucide="paperclip"></i>
                    </button>
                    <textarea asp-for="CurrentInput"
                              id="chatInput"
                              rows="1"
                              placeholder="Pregunta sobre activos, estrategias o conceptos..."
                              class="chat-textarea"
                              aria-label="Escribe tu mensaje"
                              maxlength="2000"></textarea>
                    <button type="submit"
                            id="sendBtn"
                            class="send-btn"
                            title="Enviar mensaje"
                            aria-label="Enviar mensaje">
                        <i data-lucide="arrow-up"></i>
                    </button>
                    <button type="button"
                            id="stopBtn"
                            class="stop-btn hidden"
                            title="Detener generación"
                            aria-label="Detener respuesta">
                        <i data-lucide="square"></i>
                    </button>
                </div>
                <p class="k-disclaimer">
                    Kairos puede cometer errores · Verifica siempre la información financiera
                </p>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="~/js/Kairos/Index.js" asp-append-version="true"></script>
}