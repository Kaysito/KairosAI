@using KairosAI.Models
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style type="text/css">
    /* ── Variables locales del Dashboard ── */
    :root {
        --kairos-purple: #7c3aed;
        --kairos-purple-soft: rgba(124, 58, 237, 0.85);
        --kairos-purple-glow: rgba(124, 58, 237, 0.12);
        --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    }

    .glass-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
    }

    /* ── Hover lift ── */
    .hover-lift {
        transition: transform 0.24s var(--ease-spring), box-shadow 0.24s ease;
    }

        .hover-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 36px rgba(124, 58, 237, 0.09);
        }

    /* ── Fade-in-up orquestado ── */
    .k-fade {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.55s var(--ease-out), transform 0.55s var(--ease-out);
    }

        .k-fade.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ── Header greeting ── */
    .greeting-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.7;
    }

    /* ── Switch simulado / real ── */
    .mode-switch-wrapper {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 12px 5px 8px;
        border-radius: 99px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        cursor: pointer;
        user-select: none;
        transition: border-color 0.25s, box-shadow 0.25s, transform 0.18s var(--ease-spring);
    }

        .mode-switch-wrapper:hover {
            border-color: rgba(124, 58, 237, 0.35);
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.06);
        }

        .mode-switch-wrapper.is-real {
            border-color: rgba(16, 185, 129, 0.45);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.07);
        }

    .switch-track {
        position: relative;
        width: 34px;
        height: 19px;
        border-radius: 99px;
        background: var(--border-color);
        transition: background 0.3s ease;
        flex-shrink: 0;
    }

    .mode-switch-wrapper.is-real .switch-track {
        background: #10b981;
    }

    .switch-thumb {
        position: absolute;
        top: 2.5px;
        left: 2.5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
        transition: transform 0.28s var(--ease-spring);
    }

    .mode-switch-wrapper.is-real .switch-thumb {
        transform: translateX(15px);
    }

    .switch-label-sim,
    .switch-label-real {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        color: var(--text-muted);
        transition: color 0.2s, opacity 0.2s;
    }

    .mode-switch-wrapper.is-real .switch-label-sim {
        opacity: 0.4;
    }

    .mode-switch-wrapper.is-real .switch-label-real {
        color: #10b981;
    }

    .mode-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--text-muted);
        transition: background 0.3s, box-shadow 0.3s;
        flex-shrink: 0;
    }

    .mode-switch-wrapper.is-real .mode-dot {
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        animation: modePing 2.2s ease infinite;
    }

    /* ¡ESCAPADO CON DOBLE ARROBA! */
    @@keyframes modePing {
        0%, 100% {
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.06);
        }
    }

    /* ¡ESCAPADO CON DOBLE ARROBA! */
    @@media (max-width: 480px) {
        .switch-label-sim, .switch-label-real, .mode-dot {
            display: none;
        }

        .mode-switch-wrapper {
            padding: 4px;
            gap: 0;
        }
    }

    /* ── KPI Cards ── */
    .kpi-card {
        position: relative;
        overflow: hidden;
    }

        .kpi-card .bg-icon {
            position: absolute;
            right: -10px;
            top: -10px;
            opacity: 0.028;
            transition: opacity 0.3s, transform 0.35s var(--ease-out);
            pointer-events: none;
        }

        .kpi-card:hover .bg-icon {
            opacity: 0.055;
            transform: scale(1.08) rotate(-4deg);
        }

    /* Balance counter */
    .balance-value {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
        font-size: 2rem;
        line-height: 1.1;
    }

    /* ¡ESCAPADO CON DOBLE ARROBA! */
    @@media (min-width: 640px) {
        .balance-value {
            font-size: 2.5rem;
            line-height: 1;
        }
    }

    /* ── Stat pill ── */
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .stat-pill.up {
            background: rgba(16, 185, 129, 0.14);
            color: #10b981;
        }

        .stat-pill.down {
            background: rgba(239, 68, 68, 0.14);
            color: #ef4444;
        }

    /* ── Quick access cards ── */
    .quick-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border-radius: 14px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        text-decoration: none;
        transition: border-color 0.2s, background 0.2s, transform 0.22s var(--ease-spring), box-shadow 0.22s ease;
        border-left: 3px solid transparent;
        min-width: 0;
    }

        .quick-card:hover {
            background: var(--hover-bg);
            transform: translateX(4px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        }

        .quick-card.primary-action {
            background: rgba(124, 58, 237, 0.07);
            border: 1px solid rgba(124, 58, 237, 0.35);
            border-left-width: 3px;
        }

            .quick-card.primary-action:hover {
                background: rgba(124, 58, 237, 0.13);
            }

        .quick-card.secondary-action {
            opacity: 0.72;
        }

            .quick-card.secondary-action:hover {
                opacity: 1;
            }

        .quick-card .qc-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background 0.2s, color 0.2s, transform 0.2s var(--ease-spring);
        }

        .quick-card:hover .qc-icon {
            transform: scale(1.08);
        }

        .quick-card div p {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* ── Call to Action ── */
    .cta-btn {
        background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #ec4899 100%);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 11px 22px;
        font-weight: 700;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        transition: transform 0.22s var(--ease-spring), box-shadow 0.22s ease;
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.28);
        letter-spacing: 0.01em;
    }

        .cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
        }

        .cta-btn:active {
            transform: translateY(0);
        }

    /* ── Risk bar ── */
    .risk-bar-track {
        height: 6px;
        border-radius: 99px;
        background: var(--border-color);
        overflow: hidden;
    }

    .risk-bar-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, #3b82f6, #7c3aed, #ec4899);
        transition: width 1.3s var(--ease-out);
        width: 0%;
    }

    /* ── Chart ── */
    .chart-tooltip {
        position: absolute;
        background: var(--bg-card);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 14px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.12s ease;
        z-index: 1000;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
        min-width: 155px;
        max-width: 88vw;
    }

        .chart-tooltip.visible {
            opacity: 1;
        }

    .chart-line {
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        transition: stroke-dashoffset 1.9s var(--ease-out);
    }

        .chart-line.animate {
            stroke-dashoffset: 0;
        }

    .chart-area,
    .chart-point {
        opacity: 0;
        transition: opacity 0.8s ease;
    }

        .chart-area.animate,
        .chart-point.animate {
            opacity: 1;
        }

    .chart-overlay {
        cursor: crosshair;
        touch-action: none;
    }

    .chart-crosshair-line {
        stroke: var(--kairos-purple-soft);
        stroke-width: 1;
        stroke-dasharray: 4, 4;
        opacity: 0;
        transition: opacity 0.1s;
    }

    .period-btn {
        transition: all 0.2s ease;
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-muted);
        border-radius: 8px;
        padding: 5px 14px;
        font-size: 0.73rem;
        font-weight: 600;
        cursor: pointer;
    }

        .period-btn:hover {
            color: var(--text-main);
        }

        .period-btn.active {
            background: var(--bg-card);
            color: var(--text-main);
            border-color: rgba(124, 58, 237, 0.3);
        }

    /* ── Asset & News ── */
    .asset-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 9px 11px;
        border-radius: 10px;
        transition: background 0.15s;
        cursor: pointer;
        text-decoration: none;
    }

        .asset-row:hover {
            background: var(--hover-bg);
        }

    .asset-symbol-badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.68rem;
        border: 1px solid var(--border-color);
        background: var(--bg-panel);
        color: var(--text-main);
        font-family: 'JetBrains Mono', monospace;
    }

    .section-label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.11em;
        color: var(--text-muted);
        opacity: 0.65;
    }

    .ambient-purple {
        position: absolute;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    /* ── Divider ── */
    .v-divider {
        width: 1px;
        height: 22px;
        background: var(--border-color);
    }
</style>

<div class="w-full min-h-full flex flex-col" style="background:var(--bg-main);color:var(--text-main);">

    <header class="min-h-[3.75rem] py-2 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-30"
            style="background:var(--bg-main);border-bottom:1px solid var(--border-color);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);">

        <div class="flex flex-col justify-center gap-0.5">
            <div class="greeting-time hidden md:block" style="color:var(--text-muted);" id="greeting-time">—</div>
            <h1 class="text-sm sm:text-[0.9rem] font-bold truncate" style="color:var(--text-main);line-height:1.25;">
                Tu portafolio, bajo control.
            </h1>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
            <div class="mode-switch-wrapper" id="modeSwitchWrapper" onclick="toggleMode()" role="switch"
                 aria-checked="false" tabindex="0" title="Cambiar entre modo simulado y real"
                 aria-label="Modo de operación">
                <div class="mode-dot" id="modeDot"></div>
                <span class="switch-label-sim" id="labelSim" aria-hidden="true">SIM</span>
                <div class="switch-track" id="switchTrack">
                    <div class="switch-thumb" id="switchThumb"></div>
                </div>
                <span class="switch-label-real" id="labelReal" aria-hidden="true">REAL</span>
            </div>

            <div class="v-divider hidden sm:block"></div>

            <button class="relative p-2 rounded-lg transition-colors" style="color:var(--text-muted);"
                    aria-label="Notificaciones"
                    onmouseover="this.style.color='var(--kairos-purple-soft)';this.style.background='rgba(124,58,237,0.09)'"
                    onmouseout="this.style.color='var(--text-muted)';this.style.background='transparent'">
                <i data-lucide="bell" class="w-5 h-5"></i>
                <span aria-hidden="true" style="position:absolute;top:7px;right:7px;width:6px;height:6px;border-radius:50%;background:#ef4444;"
                      class="animate-pulse"></span>
            </button>

            <button aria-label="Perfil de usuario"
                    style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#06b6d4);
                           border:2px solid var(--border-color);transition:box-shadow 0.2s;flex-shrink:0;"
                    onmouseover="this.style.boxShadow='0 0 0 3px rgba(124,58,237,0.28)'"
                    onmouseout="this.style.boxShadow='none'"></button>
        </div>
    </header>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 relative overflow-x-hidden w-full">

        <div class="ambient-purple hidden sm:block"
             style="width:520px;height:520px;top:-120px;left:-60px;opacity:0.55;"></div>
        <div class="ambient-purple"
             style="width:320px;height:320px;bottom:8%;right:4%;opacity:0.38;
                    background:radial-gradient(circle,rgba(6,182,212,0.06) 0%,transparent 70%);"></div>

        <div class="max-w-7xl mx-auto space-y-5 relative">

            <section class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5 k-fade" aria-label="Resumen principal">

                <article class="glass-panel kpi-card rounded-2xl p-5 sm:p-6 lg:col-span-2 hover-lift flex flex-col justify-center">
                    <div class="bg-icon">
                        <i data-lucide="trending-up" style="width:130px;height:130px;color:var(--kairos-purple,#7c3aed)"></i>
                    </div>

                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                        <div>
                            <p class="section-label mb-2">Balance Total del Portafolio</p>
                            <div class="flex flex-wrap items-baseline gap-2 mb-1">
                                <span class="balance-value font-bold"
                                      style="color:var(--text-main);font-family:'JetBrains Mono',monospace;">
                                    $@Model.TotalBalance.ToString("N2")
                                </span>
                                <span style="color:var(--text-muted);font-size:0.95rem;font-weight:500;">USD</span>
                            </div>
                        </div>

                        <button class="cta-btn w-full sm:w-auto justify-center z-10" type="button">
                            <i data-lucide="sparkles" size="17"></i>
                            Optimizar Portafolio
                        </button>
                    </div>

                    <div class="flex items-center gap-3 mt-4 flex-wrap">
                        <span class="stat-pill @(Model.MonthlyReturn >= 0 ? "up" : "down")">
                            <i data-lucide="@(Model.MonthlyReturn >= 0 ? "trending-up" : "trending-down")"
                               style="width:14px;height:14px;"></i>
                            @(Model.MonthlyReturn >= 0 ? "+" : "")@Model.MonthlyReturn%
                        </span>
                        <span style="color:var(--text-muted);font-size:0.82rem;">vs mes anterior</span>

                        <span class="ml-auto" style="font-size:0.62rem;opacity:0.55;font-family:'JetBrains Mono',monospace;
                                                     color:var(--text-muted);" id="last-update">
                            Actualizado hace 2 min
                        </span>
                    </div>
                </article>

                <article class="glass-panel kpi-card rounded-2xl p-5 sm:p-6 flex flex-col justify-between hover-lift">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <p class="section-label mb-1">Perfil de Riesgo IA</p>
                            <p class="text-xl font-bold" style="color:var(--text-main);line-height:1.2;">@Model.RiskLabel</p>
                        </div>
                        <div style="padding:8px;background:rgba(124,58,237,0.1);border-radius:10px;color:#7c3aed;">
                            <i data-lucide="brain-circuit" size="17"></i>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between mb-2"
                             style="font-size:0.62rem;font-weight:700;text-transform:uppercase;letter-spacing:0.09em;color:var(--text-muted);">
                            <span>Conservador</span>
                            <span>Agresivo</span>
                        </div>
                        <div class="risk-bar-track">
                            <div class="risk-bar-fill" id="riskBarFill"
                                 style="width:0%" data-target="@Model.RiskScore"></div>
                        </div>
                        <div class="flex items-center justify-between mt-3">
                            <p style="font-size:0.68rem;color:#7c3aed;display:flex;align-items:center;gap:5px;">
                                <i data-lucide="sparkles" style="width:11px;height:11px;"></i>
                                Calibrado por KairosAI
                            </p>
                            <span style="font-family:'JetBrains Mono',monospace;font-size:0.65rem;color:var(--text-muted);">
                                @Model.RiskScore/100
                            </span>
                        </div>
                    </div>
                </article>
            </section>

            <section class="k-fade" style="transition-delay:0.08s;" aria-label="Accesos rápidos">
                <p class="section-label mb-3">Navegación Rápida</p>
                <div class="grid grid-cols-1 xs:grid-cols-2 md:grid-cols-4 gap-3">

                    <a asp-controller="Kairos" asp-action="Index"
                       class="quick-card primary-action" style="border-left-color:#7c3aed;"
                       onmouseover="this.querySelector('.qc-icon').style.background='#7c3aed';this.querySelector('.qc-icon').style.color='#fff'"
                       onmouseout="this.querySelector('.qc-icon').style.background='rgba(124,58,237,0.18)';this.querySelector('.qc-icon').style.color='#7c3aed'">
                        <span class="qc-icon" style="background:rgba(124,58,237,0.18);color:#7c3aed;">
                            <i data-lucide="message-square-plus" size="17"></i>
                        </span>
                        <div class="overflow-hidden">
                            <p style="font-size:0.84rem;font-weight:800;color:var(--text-main);">Chat IA</p>
                            <p style="font-size:0.68rem;color:var(--text-muted);">Pregunta ahora</p>
                        </div>
                    </a>

                    <a href="#market-section" class="quick-card" style="border-left-color:#10b981;"
                       onmouseover="this.querySelector('.qc-icon').style.background='#10b981';this.querySelector('.qc-icon').style.color='#fff'"
                       onmouseout="this.querySelector('.qc-icon').style.background='rgba(16,185,129,0.1)';this.querySelector('.qc-icon').style.color='#10b981'">
                        <span class="qc-icon" style="background:rgba(16,185,129,0.1);color:#10b981;">
                            <i data-lucide="candlestick-chart" size="16"></i>
                        </span>
                        <div class="overflow-hidden">
                            <p style="font-size:0.82rem;font-weight:700;color:var(--text-main);">Mercado</p>
                            <p style="font-size:0.68rem;color:var(--text-muted);">Ver oportunidades</p>
                        </div>
                    </a>

                    <a asp-controller="News" asp-action="Index" class="quick-card" style="border-left-color:#3b82f6;"
                       onmouseover="this.querySelector('.qc-icon').style.background='#3b82f6';this.querySelector('.qc-icon').style.color='#fff'"
                       onmouseout="this.querySelector('.qc-icon').style.background='rgba(59,130,246,0.1)';this.querySelector('.qc-icon').style.color='#3b82f6'">
                        <span class="qc-icon" style="background:rgba(59,130,246,0.1);color:#3b82f6;">
                            <i data-lucide="newspaper" size="16"></i>
                        </span>
                        <div class="overflow-hidden">
                            <p style="font-size:0.82rem;font-weight:700;color:var(--text-main);">Noticias</p>
                            <p style="font-size:0.68rem;color:var(--text-muted);">Feed en tiempo real</p>
                        </div>
                    </a>

                    <a asp-controller="Education" asp-action="Index" class="quick-card secondary-action" style="border-left-color:#f59e0b;"
                       onmouseover="this.querySelector('.qc-icon').style.background='#f59e0b';this.querySelector('.qc-icon').style.color='#fff'"
                       onmouseout="this.querySelector('.qc-icon').style.background='rgba(245,158,11,0.1)';this.querySelector('.qc-icon').style.color='#f59e0b'">
                        <span class="qc-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b;">
                            <i data-lucide="graduation-cap" size="16"></i>
                        </span>
                        <div class="overflow-hidden">
                            <p style="font-size:0.82rem;font-weight:700;color:var(--text-main);">Academia</p>
                            <p style="font-size:0.68rem;color:var(--text-muted);">Aprende a invertir</p>
                        </div>
                    </a>
                </div>
            </section>

            <section class="k-fade" style="transition-delay:0.16s;" aria-labelledby="performance-heading">
                <article class="glass-panel rounded-2xl p-5 sm:p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-5 gap-3">
                        <div>
                            <p class="section-label mb-1">Rendimiento Histórico</p>
                            <h2 id="performance-heading"
                                style="font-size:0.93rem;font-weight:600;color:var(--text-main);display:flex;align-items:center;gap:6px;">
                                <i data-lucide="line-chart" style="width:15px;height:15px;color:#7c3aed;"></i>
                                Evolución del portafolio
                            </h2>
                        </div>
                        <div style="display:flex;background:var(--bg-main);padding:3px;border-radius:11px;
                                    border:1px solid var(--border-color);gap:3px;">
                            @foreach (var period in new[] { "7D", "1M", "1A" })
                            {
                                <button onclick="selectPeriod(this)" data-period="@period" type="button"
                                        class="period-btn @(period == "7D" ? "active" : "")">
                                    @period
                                </button>
                            }
                        </div>
                    </div>

                    <div class="relative w-full" style="height:220px;">
                        <div id="chartTooltip" class="chart-tooltip">
                            <div style="font-size:0.63rem;color:var(--text-muted);margin-bottom:4px;
                                        font-family:'JetBrains Mono',monospace;letter-spacing:0.04em;" id="tooltipDate"></div>
                            <div style="font-size:1.05rem;font-weight:700;color:var(--text-main);
                                        font-family:'JetBrains Mono',monospace;" id="tooltipValue"></div>
                            <div style="font-size:0.73rem;font-weight:600;margin-top:5px;" id="tooltipChange"></div>
                        </div>

                        @{
                            var data = Model.PerformanceData;
                            string points = "";
                            string fillPoints = "";
                            double svgW = 1000, svgH = 180;
                            double stepX = 0;
                            decimal minVal = 0, maxVal = 0, range = 1;

                            if (data.Any())
                            {
                                minVal = data.Min(d => d.Value);
                                maxVal = data.Max(d => d.Value);
                                range = maxVal - minVal;
                                if (range == 0) range = 1;
                                stepX = data.Count > 1 ? svgW / (data.Count - 1) : 0;
                                var pl = new List<string>();
                                for (int i = 0; i < data.Count; i++)
                                {
                                    double x = i * stepX;
                                    double ny = (double)((data[i].Value - minVal) / range);
                                    double y = svgH - (ny * svgH * 0.85) - svgH * 0.05;
                                    pl.Add($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
                                }
                                points = string.Join(" ", pl);
                                fillPoints = $"0,{svgH} " + points + $" {svgW},{svgH}";
                            }
                        }

                        <svg viewBox="0 0 1000 180" preserveAspectRatio="none"
                             class="w-full h-full overflow-visible" id="chartSvg" role="img"
                             aria-label="Gráfico de rendimiento del portafolio">
                            <defs>
                                <linearGradient id="chartGrad" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.22" />
                                    <stop offset="100%" stop-color="#7c3aed" stop-opacity="0" />
                                </linearGradient>
                            </defs>

                            @foreach (var yPos in new[] { 40, 90, 140 })
                            {
                                <line x1="0" y1="@yPos" x2="1000" y2="@yPos"
                                      stroke="var(--border-color)" stroke-width="1"
                                      stroke-dasharray="5,6" opacity="0.45" />
                            }

                            <line id="crosshairLine" x1="0" y1="0" x2="0" y2="180"
                                  class="chart-crosshair-line" />

                            @if (data.Any())
                            {
                                <polygon points="@fillPoints" fill="url(#chartGrad)" class="chart-area" />
                                <polyline points="@points" fill="none" stroke="#7c3aed" stroke-width="2.5"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          class="chart-line" />
                                <circle id="hoverCircle" r="5" fill="#7c3aed" stroke="#fff"
                                        stroke-width="2.5" style="opacity:0;pointer-events:none;" />

                                @for (int i = 0; i < data.Count; i++)
                                {
                                    double x = i * stepX;
                                    double ny = (double)((data[i].Value - minVal) / range);
                                    double y = svgH - (ny * svgH * 0.85) - svgH * 0.05;
                                    string cx = x.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    string cy = y.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    bool isMax = data[i].Value == maxVal;
                                    bool isMin = data[i].Value == minVal;
                                    string dotColor = isMax ? "#10b981" : isMin ? "#ef4444" : "var(--bg-main)";
                                    string strokeColor = isMax ? "#10b981" : isMin ? "#ef4444" : "#7c3aed";
                                    double radius = isMax || isMin ? 5 : 3.5;

                                    <g class="chart-point" data-index="@i">
                                        <circle cx="@cx" cy="@cy" r="@radius"
                                                fill="@dotColor" stroke="@strokeColor" stroke-width="2"
                                                data-date="@data[i].Date"
                                                data-value="@data[i].Value.ToString("N2")"
                                                data-x="@cx" data-y="@cy" />
                                        <circle cx="@cx" cy="@cy" r="14" fill="transparent" class="cursor-pointer" />

                                        @if (isMax)
                                        {
                                            @Html.Raw($"<text x=\"{cx}\" y=\"{(y - 10).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"#10b981\" font-size=\"9.5\" text-anchor=\"middle\" font-weight=\"700\">MAX</text>")
                                        }
                                        @if (isMin)
                                        {
                                            @Html.Raw($"<text x=\"{cx}\" y=\"{(y + 16).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"#ef4444\" font-size=\"9.5\" text-anchor=\"middle\" font-weight=\"700\">MIN</text>")
                                        }
                                    </g>
                                }
                            }
                        </svg>
                        <div class="chart-overlay absolute inset-0" id="chartOverlay"
                             role="presentation" aria-hidden="true"></div>
                    </div>
                </article>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5 k-fade" style="transition-delay:0.24s;" id="market-section">

                <section aria-labelledby="news-heading" class="lg:col-span-2">
                    <article class="glass-panel rounded-2xl p-5 h-full flex flex-col justify-start">
                        <div class="flex justify-between items-center mb-5">
                            <h2 id="news-heading" style="font-size:0.95rem;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:7px;">
                                <i data-lucide="zap" style="width:16px;height:16px;color:#f59e0b;"></i>
                                Señales del Mercado
                            </h2>
                            <a asp-controller="News" asp-action="Index" style="font-size:0.75rem;color:#7c3aed;text-decoration:none;font-weight:600;display:flex;align-items:center;gap:3px;opacity:0.85;transition:opacity 0.15s;" onmouseover="this.style.opacity='1';this.style.textDecoration='underline'" onmouseout="this.style.opacity='0.85';this.style.textDecoration='none'">
                                Ver feed completo →
                            </a>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 content-start">
                            @foreach (var news in Model.RecentNews.Take(4))
                            {
                                <a href="#" style="padding:16px; display:flex; flex-direction:column; justify-content:flex-start; gap:12px; border-radius:12px; border:1px solid var(--border-color); background:var(--bg-panel); text-decoration:none; transition:transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(124,58,237,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                    <div style="display:flex;justify-content:space-between;align-items:center;">
                                        <span style="font-size:0.65rem;font-weight:800;color:#7c3aed;text-transform:uppercase;letter-spacing:0.08em;">@news.Source</span>
                                        <time style="font-size:0.65rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;">@news.TimeAgo</time>
                                    </div>

                                    <h3 style="font-size:0.88rem;font-weight:600;color:var(--text-main);line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                                        @news.Title
                                    </h3>

                                    <div style="margin-top:auto; display:flex;">
                                        @{
                                            var sColor = news.Sentiment == "Positivo" ? "#10b981" : news.Sentiment == "Negativo" ? "#ef4444" : "#9ca3af";
                                            var sBg = news.Sentiment == "Positivo" ? "rgba(16,185,129,0.12)" : news.Sentiment == "Negativo" ? "rgba(239,68,68,0.12)" : "rgba(156,163,175,0.12)";
                                            var sIcon = news.Sentiment == "Positivo" ? "trending-up" : news.Sentiment == "Negativo" ? "trending-down" : "minus";
                                        }
                                        <span style="display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:99px;font-size:0.7rem;font-weight:700;background:@sBg;color:@sColor;">
                                            <i data-lucide="@sIcon" style="width:12px;height:12px;"></i> @news.Sentiment
                                        </span>
                                    </div>
                                </a>
                            }
                        </div>
                    </article>
                </section>

                <section aria-labelledby="market-heading">
                    <article class="glass-panel rounded-2xl p-5 h-full flex flex-col">
                        <div class="flex justify-between items-center mb-4">
                            <h2 id="market-heading" style="font-size:0.88rem;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:7px;">
                                <i data-lucide="layers" style="width:15px;height:15px;color:#3b82f6;"></i>
                                Mercado Hoy
                            </h2>
                        </div>

                        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:4px;flex:1;max-height:380px;overflow-y:auto;padding-right:4px;" role="list">
                            @foreach (var asset in Model.TopAssets)
                            {
                                <li>
                                    <a href="#" class="asset-row" style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; border-radius:10px; text-decoration:none; transition:background 0.2s;" onmouseover="this.style.background='var(--hover-bg)'" onmouseout="this.style.background='transparent'">
                                        <div style="display:flex;align-items:center;gap:12px;">
                                            @if (!string.IsNullOrEmpty(asset.ImageUrl))
                                            {
                                                <img src="@asset.ImageUrl" alt="@asset.Name icon" style="width:34px; height:34px; border-radius:50%; object-fit:cover; background-color:var(--bg-main);" />
                                            }
                                            else
                                            {
                                                <div class="asset-symbol-badge" style="width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.68rem; border:1px solid var(--border-color); background:var(--bg-panel); color:var(--text-main); font-family:'JetBrains Mono',monospace;">
                                                    @asset.Symbol.Substring(0, 1)
                                                </div>
                                            }
                                            <div>
                                                <div style="font-size:0.83rem;font-weight:700;color:var(--text-main);">@asset.Symbol</div>
                                                <div style="font-size:0.68rem;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:85px;">@asset.Name</div>
                                            </div>
                                        </div>
                                        <div style="text-align:right;">
                                            <div style="font-size:0.83rem;font-weight:600;color:var(--text-main);font-family:'JetBrains Mono',monospace;">
                                                $@asset.Price.ToString("N2")
                                            </div>
                                            <div style="font-size:0.73rem;font-weight:700;color:@(asset.Change24h >= 0 ? "#10b981" : "#ef4444");">
                                                @(asset.Change24h >= 0 ? "▲" : "▼") @Math.Abs(asset.Change24h).ToString("F2")%
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            }
                        </ul>
                    </article>
                </section>
            </div>
        </div>
    </main>
</div>

<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();

    // ── Greeting dinámico ──
    (function () {
        try {
            const h = new Date().getHours();
            const label = h >= 5 && h < 12 ? 'Buenos días'
                        : h >= 12 && h < 19 ? 'Buenas tardes'
                        : 'Buenas noches';
            const now = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
            const el = document.getElementById('greeting-time');
            if (el) el.textContent = `${label}, Kevin · ${now}`;
        } catch (e) {}
    })();

    // ── Animaciones al cargar ──
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.k-fade').forEach((el, i) => {
            setTimeout(() => el.classList.add('visible'), 70 + i * 85);
        });

        setTimeout(() => {
            const bar = document.getElementById('riskBarFill');
            if (bar) bar.style.width = bar.dataset.target + '%';
        }, 380);

        setTimeout(() => {
            const line = document.querySelector('.chart-line');
            const area = document.querySelector('.chart-area');
            if (line) line.classList.add('animate');
            if (area) area.classList.add('animate');
            document.querySelectorAll('.chart-point').forEach((p, i) => {
                setTimeout(() => p.classList.add('animate'), 1600 + i * 38);
            });
            setTimeout(initChart, 1900);
        }, 280);
    });

    // ── Switch Simulado / Real ──
    let isRealMode = false;
    function toggleMode() {
        isRealMode = !isRealMode;
        const wrapper = document.getElementById('modeSwitchWrapper');
        wrapper.classList.toggle('is-real', isRealMode);
        wrapper.setAttribute('aria-checked', String(isRealMode));

        wrapper.style.transition = 'none';
        wrapper.style.transform  = 'scale(0.95)';
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                wrapper.style.transition = 'transform 0.28s var(--ease-spring)';
                wrapper.style.transform  = 'scale(1)';
            });
        });
    }

    document.getElementById('modeSwitchWrapper').addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleMode(); }
    });

    // ── Period selector ──
    function selectPeriod(btn) {
        document.querySelectorAll('.period-btn').forEach(b => {
            b.classList.remove('active');
            b.style.cssText = '';
        });
        btn.classList.add('active');
    }

    // ── Datos del chart ──
    const chartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                                                                Model.PerformanceData.Select(d => new { date = d.Date, value = d.Value }).ToList()
                                ));

    function initChart() {
        const overlay     = document.getElementById('chartOverlay');
        const tooltip     = document.getElementById('chartTooltip');
        const svg         = document.getElementById('chartSvg');
        const crosshair   = document.getElementById('crosshairLine');
        const hoverCircle = document.getElementById('hoverCircle');
        const circles     = document.querySelectorAll('#chartSvg circle[data-date]');

        if (!overlay || !svg || !chartData.length) return;

        const pts = Array.from(circles).map(c => ({
            x:     parseFloat(c.getAttribute('data-x')),
            y:     parseFloat(c.getAttribute('data-y')),
            date:  c.getAttribute('data-date'),
            value: parseFloat(c.getAttribute('data-value'))
        }));

        function closest(mx) {
            const svgX = (mx / svg.getBoundingClientRect().width) * 1000;
            return pts.reduce((best, p) =>
                Math.abs(p.x - svgX) < Math.abs(best.x - svgX) ? p : best, pts[0]);
        }

        function handleMove(clientX, clientY) {
            const r  = overlay.getBoundingClientRect();
            const mx = clientX - r.left;
            const my = clientY - r.top;
            const pt  = closest(mx);
            const idx = pts.indexOf(pt);

            document.getElementById('tooltipDate').textContent  = pt.date;
            document.getElementById('tooltipValue').textContent = '$' + pt.value.toFixed(2);

            const changeEl = document.getElementById('tooltipChange');
            if (idx > 0) {
                const pct = ((pt.value - pts[idx - 1].value) / pts[idx - 1].value) * 100;
                const col = pct >= 0 ? '#10b981' : '#ef4444';
                changeEl.innerHTML = `<span style="color:${col};display:flex;align-items:center;gap:4px;">
                    ${pct >= 0 ? '▲' : '▼'} ${Math.abs(pct).toFixed(2)}% vs periodo ant.</span>`;
            } else {
                changeEl.textContent = 'Punto de inicio';
                changeEl.style.color = 'var(--text-muted)';
            }

            const tooltipW = 162;
            let tx = mx + 16;
            let ty = my - 72;
            if (tx + tooltipW > r.width) tx = mx - tooltipW - 10;
            if (tx < 4) tx = 4;
            if (ty < 4) ty = my + 18;

            tooltip.style.left = tx + 'px';
            tooltip.style.top  = ty + 'px';
            tooltip.classList.add('visible');

            crosshair.setAttribute('x1', pt.x);
            crosshair.setAttribute('x2', pt.x);
            crosshair.style.opacity = '0.55';
            hoverCircle.setAttribute('cx', pt.x);
            hoverCircle.setAttribute('cy', pt.y);
            hoverCircle.style.opacity = '1';
        }

        overlay.addEventListener('mousemove', e => handleMove(e.clientX, e.clientY));

        overlay.addEventListener('mouseleave', () => {
            tooltip.classList.remove('visible');
            crosshair.style.opacity = '0';
            hoverCircle.style.opacity = '0';
        });

        overlay.addEventListener('touchmove', e => {
            e.preventDefault();
            const t = e.touches[0];
            handleMove(t.clientX, t.clientY);
        }, { passive: false });

        overlay.addEventListener('touchend', () => {
            setTimeout(() => {
                tooltip.classList.remove('visible');
                crosshair.style.opacity = '0';
                hoverCircle.style.opacity = '0';
            }, 1200);
        });
    }
</script>