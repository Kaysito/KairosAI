@using KairosAI.Models
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    /* ── Perfil de riesgo — cálculos Razor ── */
    int axisA = Model.AggressionAxis;
    int axisB = Model.KnowledgeAxis;
    int friction = Model.FrictionLevel;
    string riskProfile = (Model.RiskProfile ?? "En calibración").Replace("Inversor ", "");

    int percA = Math.Clamp((int)(((double)(axisA - 2) / 4.0) * 100), 0, 100);
    int percB = Math.Clamp((int)(((double)(axisB - 2) / 4.0) * 100), 0, 100);

    string labelA = axisA <= 2 ? "Pasivo" : axisA <= 4 ? "Moderado" : "Agresivo";
    string labelB = axisB <= 2 ? "Principiante" : axisB <= 4 ? "Intermedio" : "Experto";

    string colorA = axisA <= 2 ? "linear-gradient(90deg,#3b82f6,#06b6d4)" : axisA <= 4 ? "linear-gradient(90deg,#06b6d4,#7c3aed)" : "linear-gradient(90deg,#7c3aed,#ec4899,#ef4444)";
    string colorB = axisB <= 2 ? "linear-gradient(90deg,#6b7280,#9ca3af)" : axisB <= 4 ? "linear-gradient(90deg,#9ca3af,#06b6d4)" : "linear-gradient(90deg,#06b6d4,#10b981)";

    string profileColor = riskProfile.Contains("Cauteloso") ? "#3b82f6" : riskProfile.Contains("Explorador") ? "#06b6d4" : riskProfile.Contains("Equilibrado") ? "#7c3aed" : riskProfile.Contains("Principiante Agresivo") ? "#ef4444" : "#ec4899";

    string frictionClass = friction == 3 ? "bg-red-500/10 text-red-500 border-red-500/20" : friction == 2 ? "bg-orange-500/10 text-orange-500 border-orange-500/20" : "bg-emerald-500/10 text-emerald-500 border-emerald-500/20";
    string frictionText = friction == 3 ? "Escudo: máximo" : friction == 2 ? "Escudo: moderado" : "Escudo: mínimo";
    string frictionIcon = friction == 3 ? "shield-alert" : friction == 2 ? "shield-check" : "shield";
}

<style type="text/css">
    :root {
        --kairos-purple: #7c3aed;
        --kairos-purple-soft: rgba(124, 58, 237, 0.85);
        --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Clases Core UI */
    .glass-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        transition: all 0.3s;
    }

    .hover-lift {
        transition: transform 0.24s var(--ease-spring), box-shadow 0.24s ease;
    }

        .hover-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 36px rgba(124, 58, 237, 0.09);
        }

    .k-fade {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.55s var(--ease-out), transform 0.55s var(--ease-out);
    }

        .k-fade.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* Switch Simulado/Real */
    .mode-switch-wrapper {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 12px 5px 8px;
        border-radius: 99px;
        border: 1px solid rgba(124, 58, 237, 0.35);
        background: rgba(124, 58, 237, 0.04);
        cursor: pointer;
        user-select: none;
        transition: all 0.25s var(--ease-spring);
    }

        .mode-switch-wrapper.is-real {
            border-color: rgba(16, 185, 129, 0.45);
            background: rgba(16, 185, 129, 0.04);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.07);
        }

    .switch-track {
        position: relative;
        width: 34px;
        height: 19px;
        border-radius: 99px;
        background: rgba(124, 58, 237, 0.4);
        flex-shrink: 0;
        transition: background 0.3s ease;
    }

    .mode-switch-wrapper.is-real .switch-track {
        background: #10b981;
    }

    .switch-thumb {
        position: absolute;
        top: 2.5px;
        left: 2.5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.22);
        transition: transform 0.28s var(--ease-spring);
    }

    .mode-switch-wrapper.is-real .switch-thumb {
        transform: translateX(15px);
    }

    .switch-label-sim {
        font-size: 0.68rem;
        font-weight: 800;
        color: var(--kairos-purple);
        letter-spacing: 0.07em;
        transition: 0.2s;
    }

    .switch-label-real {
        font-size: 0.68rem;
        font-weight: 800;
        color: var(--text-muted);
        opacity: 0.4;
        letter-spacing: 0.07em;
        transition: 0.2s;
    }

    .mode-switch-wrapper.is-real .switch-label-sim {
        color: var(--text-muted);
        opacity: 0.4;
    }

    .mode-switch-wrapper.is-real .switch-label-real {
        color: #10b981;
        opacity: 1;
    }

    .mode-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--kairos-purple);
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
        animation: modePingSim 2.2s ease infinite;
        flex-shrink: 0;
    }

    .mode-switch-wrapper.is-real .mode-dot {
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        animation: modePingReal 2.2s ease infinite;
    }

    @@keyframes modePingSim {
        0%, 100% {
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(124, 58, 237, 0.06);
        }
    }

    @@keyframes modePingReal {
        0%, 100% {
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.06);
        }
    }

    /* Modales y Toasts */
    #kairos-toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        opacity: 0;
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        padding: 12px 20px;
        border-radius: 99px;
        font-size: 0.82rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 9999;
        transition: all 0.4s var(--ease-spring);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        pointer-events: none;
    }

        #kairos-toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

    .modal-overlay {
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .modal-content {
        transition: transform 0.4s var(--ease-spring), opacity 0.3s ease;
    }

    .modal-hidden .modal-content {
        transform: scale(0.95) translateY(10px);
        opacity: 0;
    }

    /* Barras de Perfil (Animación) */
    .risk-bar-track {
        height: 5px;
        border-radius: 99px;
        background: rgba(255,255,255,0.06);
        overflow: visible;
        position: relative;
    }

    [data-theme="light"] .risk-bar-track {
        background: rgba(0,0,0,0.08);
    }

    .risk-bar-fill {
        height: 100%;
        border-radius: 99px;
        width: 0%;
        position: relative;
    }

        .risk-bar-fill::after {
            content: '';
            position: absolute;
            right: -1px;
            top: 50%;
            transform: translateY(-50%);
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: inherit;
            opacity: 0;
            transition: opacity 0.3s ease 1.2s;
        }

        .risk-bar-fill.played::after {
            opacity: 1;
            animation: barDotPulse 2.4s ease-out infinite;
        }

    @@keyframes barDotPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255,255,255,0.35);
        }

        65% {
            box-shadow: 0 0 0 6px rgba(255,255,255,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255,255,255,0);
        }
    }

    /* Chart */
    .chart-tooltip {
        position: absolute;
        background: var(--bg-card);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 10px 14px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.12s ease;
        z-index: 1000;
        box-shadow: 0 8px 28px rgba(0,0,0,0.16);
        min-width: 155px;
    }

        .chart-tooltip.visible {
            opacity: 1;
        }

    .chart-line {
        stroke-dasharray: 2000;
        stroke-dashoffset: 2000;
        transition: stroke-dashoffset 1.9s var(--ease-out);
    }

        .chart-line.animate {
            stroke-dashoffset: 0;
        }

    .chart-area, .chart-point {
        opacity: 0;
        transition: opacity 0.8s ease;
    }

        .chart-area.animate, .chart-point.animate {
            opacity: 1;
        }

    .chart-overlay {
        cursor: crosshair;
        touch-action: none;
    }

    .chart-crosshair-line {
        stroke: var(--kairos-purple-soft);
        stroke-width: 1;
        stroke-dasharray: 4,4;
        opacity: 0;
        transition: opacity 0.1s;
    }
</style>

<div class="w-full min-h-full flex flex-col" style="background:var(--bg-main);color:var(--text-main);">

    <header class="min-h-[3.75rem] py-2 flex items-center justify-between px-4 sm:px-8 sticky top-0 z-30 border-b border-white/5 backdrop-blur-md bg-[var(--bg-main)]/90">
        <div class="flex flex-col justify-center gap-0.5">
            <div class="hidden md:block text-[0.62rem] tracking-widest uppercase opacity-70 font-mono text-[var(--text-muted)]" id="greeting-time">—</div>
            <div class="flex items-center gap-3">
                <h1 class="text-sm sm:text-[0.9rem] font-bold truncate">Tu portafolio, bajo control.</h1>
                <span id="globalModeBadge" class="text-[0.55rem] px-2 py-0.5 rounded font-extrabold tracking-wide transition-all border border-purple-500/40 bg-purple-500/15 text-purple-300">
                    MODO SIMULADO
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
            <div class="mode-switch-wrapper" id="modeSwitchWrapper" onclick="toggleMode()" role="switch" aria-checked="false" title="Cambiar modo">
                <div class="mode-dot"></div>
                <span class="switch-label-sim">SIM</span>
                <div class="switch-track"><div class="switch-thumb"></div></div>
                <span class="switch-label-real">REAL</span>
            </div>

            <div class="hidden sm:block w-px h-5 bg-[var(--border-color)]"></div>

            <button class="relative p-2 rounded-lg transition-colors hover:bg-purple-500/10 text-[var(--text-muted)] hover:text-purple-400">
                <i data-lucide="bell" class="w-5 h-5"></i>
                <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
            </button>
            <button class="w-8 h-8 rounded-full border-2 border-[var(--border-color)] hover:border-purple-500 transition-all bg-gradient-to-br from-purple-600 to-cyan-500"></button>
        </div>
    </header>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 relative overflow-x-hidden w-full max-w-7xl mx-auto">

        <div class="absolute rounded-full pointer-events-none -top-[120px] -left-[60px] w-[520px] h-[520px] opacity-50 bg-[radial-gradient(circle,rgba(124,58,237,0.05)_0%,transparent_70%)]"></div>
        <div class="absolute rounded-full pointer-events-none bottom-[8%] right-[4%] w-[320px] h-[320px] opacity-40 bg-[radial-gradient(circle,rgba(6,182,212,0.06)_0%,transparent_70%)]"></div>

        <div class="space-y-5 relative">

            <section class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5 k-fade">

                <article class="glass-panel rounded-2xl p-5 sm:p-6 lg:col-span-2 hover-lift flex flex-col justify-between h-full relative overflow-hidden">
                    <i data-lucide="trending-up" class="absolute -right-2 -top-2 w-32 h-32 text-purple-500 opacity-5 pointer-events-none"></i>
                    <div>
                        <p class="text-[0.65rem] font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2">Balance Total del Portafolio</p>
                        <div class="flex items-baseline gap-2 mb-1">
                            <span class="text-4xl font-bold font-mono tracking-tight">$@Model.TotalBalance.ToString("N2")</span>
                            <span class="text-sm font-medium text-[var(--text-muted)]">USD</span>
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold @(Model.MonthlyReturn >= 0 ? "bg-emerald-500/10 text-emerald-500" : "bg-red-500/10 text-red-500")">
                                <i data-lucide="@(Model.MonthlyReturn >= 0 ? "trending-up" : "trending-down")" class="w-3.5 h-3.5"></i>
                                @(Model.MonthlyReturn >= 0 ? "+" : "")@Model.MonthlyReturn%
                            </span>
                            <span class="text-[0.82rem] text-[var(--text-muted)]">vs mes anterior</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 flex justify-between items-center border-t border-white/5">
                        <span class="text-[0.62rem] font-mono text-[var(--text-muted)] opacity-60">Actualizado hace 2 min</span>
                        <button id="btnOptimize" onclick="openOptimizationModal()" class="bg-gradient-to-r from-purple-600 to-cyan-500 text-white rounded-xl px-5 py-2.5 font-bold text-sm shadow-lg shadow-purple-500/30 hover:-translate-y-0.5 transition-transform flex items-center gap-2">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                            <span>Optimizar Portafolio</span>
                        </button>
                    </div>
                </article>

                <article class="glass-panel rounded-2xl p-5 sm:p-6 flex flex-col justify-between hover-lift h-full">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <p class="text-[0.65rem] font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1">Perfil de Riesgo</p>
                            <p class="text-lg font-bold leading-tight" style="color:@profileColor">@riskProfile</p>
                        </div>
                        <div class="p-2 bg-purple-500/10 rounded-xl text-purple-400"><i data-lucide="brain-circuit" class="w-4 h-4"></i></div>
                    </div>

                    <div class="space-y-3 flex-1 flex flex-col justify-center">
                        <div>
                            <div class="flex justify-between text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wide mb-1.5">
                                <span>Comportamiento</span>
                                <span class="text-[var(--text-main)]">@labelA</span>
                            </div>
                            <div class="risk-bar-track"><div class="risk-bar-fill" id="barFillA" data-target="@percA" style="background:@colorA"></div></div>
                        </div>
                        <div>
                            <div class="flex justify-between text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wide mb-1.5">
                                <span>Conocimiento</span>
                                <span class="text-[var(--text-main)]">@labelB</span>
                            </div>
                            <div class="risk-bar-track"><div class="risk-bar-fill" id="barFillB" data-target="@percB" style="background:@colorB"></div></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between mt-3 pt-3 border-t border-white/5">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.6rem] font-bold uppercase tracking-wide border @frictionClass">
                            <i data-lucide="@frictionIcon" class="w-3 h-3"></i> @frictionText
                        </span>
                        <div class="flex items-center gap-1 opacity-60 hover:opacity-100 transition cursor-default">
                            <span class="text-[0.55rem] font-black uppercase text-[var(--text-muted)]">Powered by</span>
                            <span class="text-[0.65rem] font-bold text-purple-400 font-mono">KairósAI</span>
                        </div>
                    </div>
                </article>
            </section>

            <section class="k-fade mt-6" style="transition-delay:0.08s;">
                <p class="text-[0.65rem] font-bold uppercase tracking-widest text-[var(--text-muted)] mb-3">Navegación Rápida</p>
                <div class="grid grid-cols-1 xs:grid-cols-2 md:grid-cols-4 gap-3">

                    <a asp-controller="Kairos" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl border border-purple-500/30 bg-purple-500/5 hover:bg-purple-500/10 hover:-translate-y-1 transition-all border-l-4 border-l-purple-500 group no-underline">
                        <div class="w-9 h-9 rounded-lg bg-purple-500/20 text-purple-500 flex items-center justify-center group-hover:scale-110 transition"><i data-lucide="message-square-plus" class="w-4 h-4"></i></div>
                        <div class="overflow-hidden">
                            <p class="text-sm font-extrabold text-[var(--text-main)]">Chat IA</p>
                            <p class="text-[0.68rem] text-[var(--text-muted)] truncate">Asesoría 24/7</p>
                        </div>
                    </a>

                    <a href="#market-section" class="flex items-center gap-3 p-3.5 rounded-xl border border-transparent bg-[var(--bg-card)] hover:bg-white/5 hover:-translate-y-1 transition-all border-l-4 border-l-emerald-500 group no-underline">
                        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center group-hover:scale-110 transition"><i data-lucide="candlestick-chart" class="w-4 h-4"></i></div>
                        <div class="overflow-hidden">
                            <p class="text-sm font-bold text-[var(--text-main)]">Mercado</p>
                            <p class="text-[0.68rem] text-[var(--text-muted)] truncate">Ver oportunidades</p>
                        </div>
                    </a>

                    <a asp-controller="News" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl border border-transparent bg-[var(--bg-card)] hover:bg-white/5 hover:-translate-y-1 transition-all border-l-4 border-l-blue-500 group no-underline">
                        <div class="w-9 h-9 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center group-hover:scale-110 transition"><i data-lucide="newspaper" class="w-4 h-4"></i></div>
                        <div class="overflow-hidden">
                            <p class="text-sm font-bold text-[var(--text-main)]">Noticias</p>
                            <p class="text-[0.68rem] text-[var(--text-muted)] truncate">Feed en tiempo real</p>
                        </div>
                    </a>

                    <a asp-controller="Education" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl border border-transparent bg-[var(--bg-card)] hover:bg-white/5 hover:-translate-y-1 transition-all border-l-4 border-l-orange-500 group no-underline opacity-80 hover:opacity-100">
                        <div class="w-9 h-9 rounded-lg bg-orange-500/10 text-orange-500 flex items-center justify-center group-hover:scale-110 transition"><i data-lucide="graduation-cap" class="w-4 h-4"></i></div>
                        <div class="overflow-hidden">
                            <p class="text-sm font-bold text-[var(--text-main)]">Academia</p>
                            <p class="text-[0.68rem] text-[var(--text-muted)] truncate">Gana KP aprendiendo</p>
                        </div>
                    </a>

                </div>
            </section>

            <section class="k-fade mt-6" style="transition-delay:0.16s;">
                <article class="glass-panel rounded-2xl p-5 sm:p-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-5 gap-3">
                        <div>
                            <p class="text-[0.65rem] font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1">Rendimiento Histórico</p>
                            <h2 class="text-base font-bold text-[var(--text-main)] flex items-center gap-2">
                                <i data-lucide="line-chart" class="w-4 h-4 text-purple-400"></i> Evolución del portafolio
                            </h2>
                        </div>
                        <div class="flex bg-[var(--bg-main)] p-1 rounded-xl border border-white/5 gap-1">
                            @foreach (var period in new[] { "7D", "1M", "1A" })
                            {
                                <button onclick="selectPeriod(this)" class="px-3 py-1 rounded-lg text-xs font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] transition @(period == "7D" ? "bg-[var(--bg-card)] text-[var(--text-main)] border border-purple-500/30" : "")">@period</button>
                            }
                        </div>
                    </div>

                    <div class="relative w-full h-[220px]">
                        <div id="chartTooltip" class="chart-tooltip">
                            <div class="text-[0.6rem] text-[var(--text-muted)] mb-1 font-mono tracking-wider" id="tooltipDate"></div>
                            <div class="text-lg font-bold text-[var(--text-main)] font-mono" id="tooltipValue"></div>
                            <div class="text-xs font-bold mt-1" id="tooltipChange"></div>
                        </div>
                        @{
                            var data = Model.PerformanceData;
                            string points = "", fillPoints = "";
                            double svgW = 1000, svgH = 180, stepX = 0;
                            decimal minVal = 0, maxVal = 0, range = 1;

                            if (data.Any())
                            {
                                minVal = data.Min(d => d.Value);
                                maxVal = data.Max(d => d.Value);
                                range = maxVal - minVal;
                                if (range == 0) range = 1;
                                stepX = data.Count > 1 ? svgW / (data.Count - 1) : 0;
                                var pl = new List<string>();
                                for (int i = 0; i < data.Count; i++)
                                {
                                    double x = i * stepX;
                                    double ny = (double)((data[i].Value - minVal) / range);
                                    double y = svgH - (ny * svgH * 0.85) - svgH * 0.05;
                                    pl.Add($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
                                }
                                points = string.Join(" ", pl);
                                fillPoints = $"0,{svgH} " + points + $" {svgW},{svgH}";
                            }
                        }
                        <svg viewBox="0 0 1000 180" preserveAspectRatio="none" class="w-full h-full overflow-visible" id="chartSvg">
                            <defs>
                                <linearGradient id="chartGrad" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.22" />
                                    <stop offset="100%" stop-color="#7c3aed" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            @foreach (var yPos in new[] { 40, 90, 140 })
                            {
                                <line x1="0" y1="@yPos" x2="1000" y2="@yPos" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="5,6" opacity="0.45" />
                            }
                            <line id="crosshairLine" x1="0" y1="0" x2="0" y2="180" class="chart-crosshair-line" />
                            @if (data.Any())
                            {
                                <polygon points="@fillPoints" fill="url(#chartGrad)" class="chart-area" />
                                <polyline points="@points" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chart-line" />
                                <circle id="hoverCircle" r="5" fill="#7c3aed" stroke="#fff" stroke-width="2.5" style="opacity:0;pointer-events:none;" />
                                @for (int i = 0; i < data.Count; i++)
                                {
                                    double x = i * stepX;
                                    double ny = (double)((data[i].Value - minVal) / range);
                                    double y = svgH - (ny * svgH * 0.85) - svgH * 0.05;
                                    string cx = x.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    string cy = y.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    bool isMax = data[i].Value == maxVal;
                                    bool isMin = data[i].Value == minVal;
                                    string dotClr = isMax ? "#10b981" : isMin ? "#ef4444" : "var(--bg-main)";
                                    string stkClr = isMax ? "#10b981" : isMin ? "#ef4444" : "#7c3aed";
                                    double rad = isMax || isMin ? 5 : 3.5;

                                    <g class="chart-point" data-index="@i">
                                        <circle cx="@cx" cy="@cy" r="@rad" fill="@dotClr" stroke="@stkClr" stroke-width="2" data-date="@data[i].Date" data-value="@data[i].Value.ToString("N2")" data-x="@cx" data-y="@cy" />
                                        <circle cx="@cx" cy="@cy" r="14" fill="transparent" class="cursor-pointer" />
                                        @if (isMax)
                                        {
                                            @Html.Raw($"<text x=\"{cx}\" y=\"{(y - 10).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"#10b981\" font-size=\"9.5\" text-anchor=\"middle\" font-weight=\"700\">MAX</text>")
                                        }
                                        @if (isMin)
                                        {
                                            @Html.Raw($"<text x=\"{cx}\" y=\"{(y + 16).ToString(System.Globalization.CultureInfo.InvariantCulture)}\" fill=\"#ef4444\" font-size=\"9.5\" text-anchor=\"middle\" font-weight=\"700\">MIN</text>")
                                        }
                                    </g>
                                }
                            }
                        </svg>
                        <div class="chart-overlay absolute inset-0 z-10" id="chartOverlay"></div>
                    </div>
                </article>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-5 k-fade mt-6" style="transition-delay:0.24s;" id="market-section">

                <section class="lg:col-span-2">
                    <article class="glass-panel rounded-2xl p-5 h-full flex flex-col">
                        <div class="flex justify-between items-center mb-5">
                            <h2 class="text-sm font-bold flex items-center gap-2 text-[var(--text-main)]">
                                <i data-lucide="zap" class="w-4 h-4 text-orange-500"></i> Señales del Mercado
                            </h2>
                            <a asp-controller="News" asp-action="Index" class="text-xs font-bold text-purple-400 hover:text-purple-300 transition no-underline">Ver feed completo →</a>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var news in Model.RecentNews.Take(4))
                            {
                                var sColor = news.Sentiment == "Positivo" ? "text-emerald-500 bg-emerald-500/10" : news.Sentiment == "Negativo" ? "text-red-500 bg-red-500/10" : "text-gray-400 bg-gray-500/10";
                                var sIcon = news.Sentiment == "Positivo" ? "trending-up" : news.Sentiment == "Negativo" ? "trending-down" : "minus";

                                <a href="#" class="p-4 flex flex-col gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] no-underline transition-all duration-200 hover:-translate-y-1 hover:border-purple-500/30 hover:shadow-lg hover:shadow-purple-500/5">
                                    <div class="flex justify-between items-center">
                                        <span class="text-[0.65rem] font-extrabold text-purple-400 uppercase tracking-wider">@news.Source</span>
                                        <time class="text-[0.65rem] text-[var(--text-muted)] font-mono">@news.TimeAgo</time>
                                    </div>
                                    <h3 class="text-sm font-bold text-[var(--text-main)] leading-snug line-clamp-2">@news.Title</h3>
                                    <div class="mt-auto pt-2">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.65rem] font-bold @sColor">
                                            <i data-lucide="@sIcon" class="w-3 h-3"></i> @news.Sentiment
                                        </span>
                                    </div>
                                </a>
                            }
                        </div>
                    </article>
                </section>

                <section>
                    <article class="glass-panel rounded-2xl p-5 h-full flex flex-col">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-sm font-bold flex items-center gap-2 text-[var(--text-main)]">
                                <i data-lucide="layers" class="w-4 h-4 text-blue-500"></i> Mercado Hoy
                            </h2>
                        </div>

                        <div class="flex flex-col flex-1 overflow-y-auto pr-1" style="max-height: 340px;">
                            @foreach (var asset in Model.TopAssets)
                            {
                                <a href="#" class="flex items-center justify-between py-3 px-2 rounded-xl hover:bg-[var(--hover-bg)] transition-colors border-b border-[var(--border-color)] last:border-0 no-underline">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(asset.ImageUrl))
                                        {
                                            <img src="@asset.ImageUrl" class="w-8 h-8 rounded-full object-cover bg-black/20" alt="@asset.Symbol" />
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 rounded-full border border-[var(--border-color)] flex items-center justify-center font-bold text-xs font-mono bg-[var(--bg-panel)] text-[var(--text-main)]">
                                                @asset.Symbol.Substring(0, 1)
                                            </div>
                                        }
                                        <div class="flex flex-col">
                                            <span class="text-sm font-bold text-[var(--text-main)] leading-tight">@asset.Symbol</span>
                                            <span class="text-xs text-[var(--text-muted)] truncate w-20">@asset.Name</span>
                                        </div>
                                    </div>
                                    <div class="text-right flex flex-col">
                                        <span class="text-[0.85rem] font-bold text-[var(--text-main)] tabular-nums font-mono">$@asset.Price.ToString("N2")</span>
                                        <span class="text-xs font-bold @(asset.Change24h >= 0 ? "text-emerald-500" : "text-red-500")">
                                            @(asset.Change24h >= 0 ? "▲" : "▼") @Math.Abs(asset.Change24h).ToString("F2")%
                                        </span>
                                    </div>
                                </a>
                            }
                        </div>
                    </article>
                </section>
            </div>
        </div>
    </main>

    <div id="kairos-toast" aria-live="polite">
        <i id="toast-icon" data-lucide="info" class="w-4 h-4"></i>
        <span id="toast-message">Notificación</span>
    </div>

    <div id="optimizeModal" class="fixed inset-0 z-[100] flex items-center justify-center modal-overlay modal-hidden" style="opacity: 0; pointer-events: none;">
        <div class="glass-panel modal-content rounded-2xl p-6 max-w-md w-full mx-4 shadow-2xl" style="border: 1px solid rgba(124,58,237,0.4);">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 rounded-xl" style="background:rgba(124,58,237,0.15); color:#7c3aed;">
                    <i data-lucide="sparkles"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-[var(--text-main)]">Sugerencia KairósAI</h3>
                    <p class="text-[0.65rem] text-[var(--text-muted)] font-mono uppercase tracking-wider">Análisis en tiempo real</p>
                </div>
            </div>
            <div class="space-y-4 mb-6">
                <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                    He detectado una desviación en tu tolerancia al riesgo. Para mantener tu perfil <strong style="color:@profileColor">@riskProfile</strong> en un mercado volátil, sugiero la siguiente acción de balanceo:
                </p>
                <div class="p-4 rounded-xl" style="background:rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.2);">
                    <div class="flex items-center justify-between mb-2 text-emerald-500">
                        <span class="text-xs font-bold uppercase tracking-wider">Rebalanceo Recomendado</span>
                        <i data-lucide="arrow-right-left" class="w-4 h-4"></i>
                    </div>
                    <p class="text-sm font-medium text-[var(--text-main)]">Asegurar ganancias: Mover 5% de activos de alto riesgo hacia Stablecoins (USDT).</p>
                </div>
            </div>
            <div class="flex gap-3 justify-end">
                <button onclick="closeOptimizationModal()" class="px-5 py-2 rounded-xl font-bold text-sm transition" style="background:transparent; border:1px solid var(--border-color); color:var(--text-main);">
                    Ignorar
                </button>
                <button onclick="applyOptimization()" class="px-5 py-2 rounded-xl text-white font-bold text-sm shadow-lg transition" style="background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%); border:none;">
                    Aplicar Cambios
                </button>
            </div>
        </div>
    </div>

</div>

<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();

    // ── Greeting dinámico ──
    (function () {
        try {
            const h = new Date().getHours();
            const label = h >= 5 && h < 12 ? 'Buenos días' : h >= 12 && h < 19 ? 'Buenas tardes' : 'Buenas noches';
            const now = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
            const el = document.getElementById('greeting-time');
            if (el) el.textContent = `${label}, Kevin · ${now}`;
        } catch (e) {}
    })();

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.k-fade').forEach((el, i) => {
            setTimeout(() => el.classList.add('visible'), 70 + i * 85);
        });

        // ── Animación barras de perfil de riesgo ──
        setTimeout(() => {
            function animateBar(el) {
                if (!el) return;
                const target = parseInt(el.dataset.target, 10);
                const overshoot = Math.min(target + 7, 100);
                el.style.transition = 'width 0.85s cubic-bezier(0.34, 1.56, 0.64, 1)';
                el.style.width = overshoot + '%';
                setTimeout(() => {
                    el.style.transition = 'width 0.32s cubic-bezier(0.22, 1, 0.36, 1)';
                    el.style.width = target + '%';
                }, 880);
                setTimeout(() => el.classList.add('played'), 1240);
            }
            animateBar(document.getElementById('barFillA'));
            setTimeout(() => animateBar(document.getElementById('barFillB')), 160);
        }, 400);

        // ── Chart ──
        setTimeout(() => {
            const line = document.querySelector('.chart-line');
            const area = document.querySelector('.chart-area');
            if (line) line.classList.add('animate');
            if (area) area.classList.add('animate');
            document.querySelectorAll('.chart-point').forEach((p, i) => {
                setTimeout(() => p.classList.add('animate'), 1600 + i * 38);
            });
            setTimeout(initChart, 1900);
        }, 280);
    });

    // ── Toast Utility ──
    let toastTimeout;
    function showToast(message, mode) {
        const toast = document.getElementById('kairos-toast');
        document.getElementById('toast-message').textContent = message;
        const iconEl = document.getElementById('toast-icon');

        if (mode === 'real') {
            toast.style.borderColor = 'rgba(16, 185, 129, 0.4)'; toast.style.color = '#10b981';
            iconEl.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
        } else if (mode === 'sim') {
            toast.style.borderColor = 'rgba(124, 58, 237, 0.4)'; toast.style.color = '#7c3aed';
            iconEl.innerHTML = '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>';
        } else {
            toast.style.borderColor = 'var(--border-color)'; toast.style.color = 'var(--text-main)';
            iconEl.innerHTML = '<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="m9 12 2 2 4-4"></path>';
        }

        lucide.createIcons({ root: toast });
        toast.classList.add('show');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => { toast.classList.remove('show'); }, 4000);
    }

    // ── Switch Simulado / Real ──
    let isRealMode = false;
    function toggleMode() {
        isRealMode = !isRealMode;
        const wrapper = document.getElementById('modeSwitchWrapper');
        const badge = document.getElementById('globalModeBadge');
        const ambientGlow = document.getElementById('ambientLeft');

        wrapper.classList.toggle('is-real', isRealMode);
        wrapper.setAttribute('aria-checked', String(isRealMode));

        // Efecto click
        wrapper.style.transform = 'scale(0.95)';
        setTimeout(() => wrapper.style.transform = 'scale(1)', 150);

        if (isRealMode) {
            badge.textContent = 'MODO REAL';
            badge.style.background = 'rgba(16, 185, 129, 0.15)'; badge.style.color = '#10b981'; badge.style.borderColor = 'rgba(16, 185, 129, 0.4)';
            if (ambientGlow) ambientGlow.style.background = 'radial-gradient(circle, rgba(16, 185, 129, 0.05) 0%, transparent 70%)';
            showToast('Estás operando con saldo real.', 'real');
        } else {
            badge.textContent = 'MODO SIMULADO';
            badge.style.background = 'rgba(124, 58, 237, 0.15)'; badge.style.color = '#c4b5fd'; badge.style.borderColor = 'rgba(124, 58, 237, 0.4)';
            if (ambientGlow) ambientGlow.style.background = 'radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%)';
            showToast('Modo simulado activado.', 'sim');
        }
    }

    // ── Lógica del Botón Conceptual "Optimizar Portafolio" REPARADA ──
    function openOptimizationModal() {
        const btn = document.getElementById('btnOptimize');

        // Guardamos el estado actual (SVG y Texto)
        const originalHTML = btn.innerHTML;

        // Deshabilitamos el botón temporalmente
        btn.style.pointerEvents = 'none';

        // Reemplazamos el interior con una etiqueta <i> nueva que lucide pueda convertir
        btn.innerHTML = '<i data-lucide="loader-2" style="width:17px;height:17px;" class="animate-spin"></i> <span>Analizando...</span>';

        // Renderizamos SOLO los iconos dentro del botón
        lucide.createIcons({ root: btn });

        // Simular tiempo de respuesta de IA (1.5s)
        setTimeout(() => {
            // Restaurar HTML original para recuperar el icono de destellos
            btn.innerHTML = originalHTML;
            btn.style.pointerEvents = 'auto';

            // Mostrar el Modal
            const modal = document.getElementById('optimizeModal');
            modal.classList.remove('modal-hidden');
            modal.style.opacity = '1';
            modal.style.pointerEvents = 'auto';
        }, 1500);
    }

    function closeOptimizationModal() {
        const modal = document.getElementById('optimizeModal');
        modal.classList.add('modal-hidden');
        modal.style.opacity = '0';
        modal.style.pointerEvents = 'none';
    }

    function applyOptimization() {
        closeOptimizationModal();
        showToast('Rebalanceo aplicado. Portafolio asegurado.', 'real');
    }

    // ── Period selector ──
    function selectPeriod(btn) {
        btn.parentElement.querySelectorAll('button').forEach(b => {
            b.className = 'px-3 py-1 rounded-lg text-xs font-bold text-[var(--text-muted)] hover:text-[var(--text-main)] transition';
        });
        btn.className = 'px-3 py-1 rounded-lg text-xs font-bold text-[var(--text-main)] bg-[var(--bg-card)] border border-purple-500/30 transition';
    }

    // ── Chart data ──
    const chartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PerformanceData.Select(d => new { date = d.Date, value = d.Value }).ToList()));

    function initChart() {
        const overlay = document.getElementById('chartOverlay');
        const tooltip = document.getElementById('chartTooltip');
        const svg = document.getElementById('chartSvg');
        const crosshair = document.getElementById('crosshairLine');
        const hoverCircle = document.getElementById('hoverCircle');
        const circles = document.querySelectorAll('#chartSvg circle[data-date]');

        if (!overlay || !svg || !chartData.length) return;

        const pts = Array.from(circles).map(c => ({
            x: parseFloat(c.getAttribute('data-x')),
            y: parseFloat(c.getAttribute('data-y')),
            date: c.getAttribute('data-date'),
            value: parseFloat(c.getAttribute('data-value'))
        }));

        function closest(mx) {
            const svgX = (mx / svg.getBoundingClientRect().width) * 1000;
            return pts.reduce((best, p) => Math.abs(p.x - svgX) < Math.abs(best.x - svgX) ? p : best, pts[0]);
        }

        function handleMove(clientX, clientY) {
            const r = overlay.getBoundingClientRect();
            const mx = clientX - r.left;
            const my = clientY - r.top;
            const pt = closest(mx);
            const idx = pts.indexOf(pt);

            document.getElementById('tooltipDate').textContent = pt.date;
            document.getElementById('tooltipValue').textContent = '$' + pt.value.toFixed(2);

            const changeEl = document.getElementById('tooltipChange');
            if (idx > 0) {
                const pct = ((pt.value - pts[idx - 1].value) / pts[idx - 1].value) * 100;
                const col = pct >= 0 ? '#10b981' : '#ef4444';
                changeEl.innerHTML = `<span style="color:${col};display:flex;align-items:center;gap:4px;">${pct >= 0 ? '▲' : '▼'} ${Math.abs(pct).toFixed(2)}% vs periodo ant.</span>`;
            } else {
                changeEl.textContent = 'Punto de inicio'; changeEl.style.color = 'var(--text-muted)';
            }

            let tx = mx + 16, ty = my - 72;
            if (tx + 162 > r.width) tx = mx - 172;
            if (tx < 4) tx = 4;
            if (ty < 4) ty = my + 18;

            tooltip.style.left = tx + 'px'; tooltip.style.top = ty + 'px';
            tooltip.classList.add('visible');

            crosshair.setAttribute('x1', pt.x); crosshair.setAttribute('x2', pt.x);
            crosshair.style.opacity = '0.55';
            hoverCircle.setAttribute('cx', pt.x); hoverCircle.setAttribute('cy', pt.y);
            hoverCircle.style.opacity = '1';
        }

        overlay.addEventListener('mousemove', e => handleMove(e.clientX, e.clientY));
        overlay.addEventListener('mouseleave', () => {
            tooltip.classList.remove('visible'); crosshair.style.opacity = '0'; hoverCircle.style.opacity = '0';
        });
        overlay.addEventListener('touchmove', e => { e.preventDefault(); handleMove(e.touches[0].clientX, e.touches[0].clientY); }, { passive: false });
        overlay.addEventListener('touchend', () => { setTimeout(() => { tooltip.classList.remove('visible'); crosshair.style.opacity = '0'; hoverCircle.style.opacity = '0'; }, 1200); });
    }
</script>