@model KairosAI.Models.EducationIndexViewModel

@{
    ViewData["Title"] = "Academia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header class="h-16 border-b border-kairos-border flex items-center justify-between px-6 bg-kairos-dark/80 backdrop-blur-md z-20 mb-8 rounded-b-2xl sticky top-0 transition-colors">
    <div>
        <h1 class="text-2xl font-bold text-kairos-text flex items-center gap-2">
            <i data-lucide="graduation-cap" class="text-kairos-purple"></i>
            Academia Kairos
        </h1>
        <p class="text-sm text-kairos-muted">Aprende, progresa y aumenta tu nivel</p>
    </div>

    <div class="flex items-center gap-4">
        <button class="p-2 text-kairos-muted hover:text-kairos-purple hover:bg-kairos-hover rounded-full transition relative"
                aria-label="Notificaciones">
            <i data-lucide="bell" size="20"></i>
            <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full"></span>
        </button>

        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-purple-500 to-blue-500 border border-kairos-border"></div>
    </div>
</header>

<div class="animate-fade-in-up pb-10">

    <div class="flex flex-col md:flex-row justify-between items-center mb-8">

        <div class="mt-4 md:mt-0 flex items-center gap-4 px-6 py-4 rounded-2xl bg-kairos-card border border-kairos-border shadow-lg shadow-purple-900/5 transition-colors">
            <div class="bg-yellow-500/10 p-3 rounded-xl text-yellow-600 dark:text-yellow-400 border border-yellow-500/20">
                <i data-lucide="trophy" size="24"></i>
            </div>
            <div>
                <p class="text-xs text-kairos-muted font-bold uppercase tracking-wider">Tu Experiencia</p>
                <p class="text-2xl font-bold text-kairos-text">@Model.TotalPoints <span class="text-sm text-kairos-purple font-medium">KP</span></p>
            </div>

            <div class="h-8 w-px bg-kairos-border mx-2 hidden md:block"></div>

            <div class="hidden md:block text-right">
                <p class="text-xs text-kairos-muted">Siguiente Nivel</p>
                <p class="text-sm font-semibold text-kairos-purple">Explorador Sr.</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var module in Model.Modules)
        {
            // CAMBIO: Estilo 'Fantasma' suave para bloqueados
            var lockedStyle = module.IsLocked
            ? "opacity-80 grayscale cursor-not-allowed bg-gray-50 dark:bg-[#1a1a2e]/40 border-dashed border-gray-300 dark:border-gray-700 shadow-none"
            : "bg-kairos-card hover:-translate-y-1 hover:shadow-xl hover:shadow-purple-900/10 dark:hover:shadow-purple-900/20 hover:border-kairos-purple/30";

            var levelBadge = module.Level switch
            {
                "Básico" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20",
                "Intermedio" => "bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/20",
                "Avanzado" => "bg-rose-500/10 text-rose-700 dark:text-rose-400 border-rose-500/20",
                _ => "bg-gray-500/10 text-gray-600 dark:text-gray-300 border-gray-500/20"
            };

            <div class="relative flex flex-col h-full border rounded-2xl p-6 transition-all duration-300 @lockedStyle group">

                <div class="flex justify-between items-start mb-5">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center border border-transparent transition-colors
                                        @(module.IsLocked ? "bg-gray-100 dark:bg-gray-800 text-gray-400" : "bg-kairos-panel text-kairos-text group-hover:text-kairos-purple group-hover:border-kairos-purple/50 border-kairos-border")">
                        @if (module.IsLocked)
                        {
                            <i data-lucide="lock" size="20"></i>
                        }
                        else
                        {
                            <i data-lucide="@module.Icon.ToLower()" size="24" class="transition-transform group-hover:scale-110 duration-300"></i>
                        }
                    </div>

                    <span class="px-3 py-1 rounded-full text-xs font-bold border @levelBadge @(module.IsLocked ? "opacity-50" : "")">
                        @module.Level
                    </span>
                </div>

                <div class="flex-1">
                    <h3 class="text-xl font-bold mb-2 transition-colors @(module.IsLocked ? "text-gray-400 dark:text-gray-500" : "text-kairos-text")">
                        @module.Title
                    </h3>
                    <p class="text-sm leading-relaxed mb-4 line-clamp-3 @(module.IsLocked ? "text-gray-400" : "text-kairos-muted")">
                        @module.Description
                    </p>
                </div>

                <div class="mt-4 pt-4 border-t @(module.IsLocked ? "border-gray-200 dark:border-gray-700" : "border-kairos-border")">
                    <div class="flex justify-between text-xs mb-2 font-medium @(module.IsLocked ? "text-gray-400" : "text-kairos-muted")">
                        <span>Progreso</span>
                        <span class="@(module.Progress == 100 ? "text-green-500" : "")">@module.Progress%</span>
                    </div>

                    <div class="w-full h-2 rounded-full overflow-hidden mb-5 @(module.IsLocked ? "bg-gray-200 dark:bg-gray-800" : "bg-gray-100 dark:bg-gray-800")">
                        <div class="h-full bg-gradient-to-r from-purple-600 to-blue-500 transition-all duration-1000" style="width: @module.Progress%"></div>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold flex items-center gap-1 px-2 py-1 rounded-md @(module.IsLocked ? "text-gray-400 bg-gray-100 dark:bg-gray-800" : "text-purple-600 dark:text-purple-300 bg-purple-500/5")">
                            <i data-lucide="star" size="12"></i> +@module.RewardPoints XP
                        </span>

                        @if (module.IsLocked)
                        {
                            <div class="px-4 py-2 text-sm font-medium text-gray-400 bg-transparent rounded-lg border border-dashed border-gray-300 dark:border-gray-600 cursor-not-allowed flex items-center gap-2">
                                <i data-lucide="lock" size="14"></i>
                                Bloqueado
                            </div>
                        }
                        else
                        {
                            <a href="@Url.Action("Lesson", "Education", new { id = module.Id })"
                               class="px-4 py-2 text-sm font-bold text-white bg-kairos-purple hover:bg-purple-600 rounded-lg transition-all flex items-center gap-2 shadow-md hover:shadow-lg shadow-purple-500/20 active:scale-95">
                                @(module.Progress > 0 ? "Continuar" : "Empezar")
                                <i data-lucide="arrow-right" size="16"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

@section Scripts {
        <script>
            // Aseguramos que los iconos carguen
            if(typeof lucide !== 'undefined') lucide.createIcons();

            // Animación simple de entrada
            document.addEventListener('DOMContentLoaded', () => {
                 const container = document.querySelector('.animate-fade-in-up');
                 if(container) {
                     container.style.opacity = '0';
                     container.style.transform = 'translateY(10px)';
                     setTimeout(() => {
                         container.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                         container.style.opacity = '1';
                         container.style.transform = 'translateY(0)';
                     }, 100);
                 }
            });
        </script>
}
