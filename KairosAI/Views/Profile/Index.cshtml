                            <div class="profile-card-icon" style="background:rgba(16,185,129,0.1);color:#10b981;">
                                <i data-lucide="shield-check" style="width:17px;height:17px;"></i>
                            </div>
                            <div>
                                <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);">Autenticación 2FA</h2>
                                <p style="font-size:0.7rem;color:var(--text-muted);">Actualmente: desactivado</p>
                            </div>
                        </div>
                        <div class="profile-card-body">
                            <p style="font-size:0.8rem;color:var(--text-muted);line-height:1.6;margin-bottom:14px;">
                                Agrega una capa extra de seguridad con Google Authenticator o SMS.
                            </p>
                            <button class="btn-primary" type="button" style="background:#10b981;box-shadow:0 4px 14px rgba(16,185,129,0.25);">
                                <i data-lucide="shield-plus" style="width:14px;height:14px;"></i>
                                Activar 2FA
                            </button>
                        </div>
                    </div>

                    <!-- Sesiones activas -->
                    <div class="profile-card">
                        <div class="profile-card-header">
                            <div class="profile-card-icon" style="background:rgba(239,68,68,0.1);color:#ef4444;">
                                <i data-lucide="monitor" style="width:17px;height:17px;"></i>
                            </div>
                            <div>
                                <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);">Sesiones Activas</h2>
                                <p style="font-size:0.7rem;color:var(--text-muted);">2 dispositivos conectados</p>
                            </div>
                        </div>
                        <div class="profile-card-body" style="display:flex;flex-direction:column;gap:8px;">
                            @foreach (var (device, loc, current) in new[]{
                                                        ("Chrome · macOS","CDMX, México",true),
                                                        ("Safari · iPhone 15","CDMX, México",false)
                                                        })
                            {
                                <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:1px solid var(--border-color);background:var(--bg-panel);">
                                    <i data-lucide="@(device.Contains("iPhone") ? "smartphone" : "monitor")" style="width:15px;height:15px;color:var(--text-muted);flex-shrink:0;"></i>
                                    <div style="flex:1;min-width:0;">
                                        <p style="font-size:0.78rem;font-weight:600;color:var(--text-main);">@device</p>
                                        <p style="font-size:0.68rem;color:var(--text-muted);">@loc</p>
                                    </div>
                                    @if (current)
                                    {
                                        <span style="font-size:0.6rem;font-weight:700;padding:2px 7px;border-radius:99px;background:rgba(16,185,129,0.1);color:#10b981;border:1px solid rgba(16,185,129,0.2);">ACTUAL</span>
                                    }
                                    else
                                    {
                                        <button class="btn-danger" type="button" style="padding:5px 10px;font-size:0.68rem;">Cerrar</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ══════════════════════════════════
             TAB 5: CUENTA Y PLAN
        ══════════════════════════════════ -->
        <div id="tab-cuenta" class="tab-panel k-fade" style="transition-delay:0.1s;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;" class="profile-main-grid">

                <!-- Plan actual -->
                <div class="profile-card">
                    <div class="profile-card-header">
                        <div class="profile-card-icon" style="background:rgba(124,58,237,0.1);color:#7c3aed;">
                            <i data-lucide="credit-card" style="width:17px;height:17px;"></i>
                        </div>
                        <div>
                            <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);">Plan Actual</h2>
                            <p style="font-size:0.7rem;color:var(--text-muted);">Gestión de suscripción</p>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid var(--border-color);">
                            <div>
                                <p style="font-size:0.7rem;color:var(--text-muted);margin-bottom:4px;">Plan activo</p>
                                <span class="plan-badge plan-pro" style="font-size:0.78rem;padding:5px 14px;">
                                    <i data-lucide="sparkles" style="width:12px;height:12px;"></i>
                                    @Model.SubscriptionPlan
                                </span>
                            </div>
                            <div style="text-align:right;">
                                <p style="font-size:0.7rem;color:var(--text-muted);">Próxima factura</p>
                                <p style="font-size:0.85rem;font-weight:700;color:var(--text-main);font-family:'JetBrains Mono',monospace;">18 Mar 2026</p>
                            </div>
                        </div>
                        @foreach (var (feature, included) in new[]{
                                                ("Chat con KairosAI ilimitado",true),
                                                ("Análisis de portafolio IA",true),
                                                ("Alertas de precio en tiempo real",true),
                                                ("Acceso a todos los módulos",true),
                                                ("Signals de trading avanzados",false),
                                                ("API de portafolio personal",false)
                                                })
                        {
                            <div style="display:flex;align-items:center;gap:8px;padding:6px 0;">
                                <i data-lucide="@(included ? "check" : "x")" style="width:14px;height:14px;color:@(included ? "#10b981" : "#6b7280");flex-shrink:0;"></i>
                                <span style="font-size:0.78rem;color:@(included ? "var(--text-main)" : "var(--text-muted)");">@feature</span>
                            </div>
                        }
                        <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border-color);display:flex;gap:8px;flex-wrap:wrap;">
                            <button class="btn-primary" type="button" style="flex:1;justify-content:center;">
                                <i data-lucide="zap" style="width:14px;height:14px;"></i>
                                Upgrade a Elite
                            </button>
                            <button class="btn-secondary" type="button">
                                Gestionar
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Info cuenta + eliminar -->
                <div style="display:flex;flex-direction:column;gap:18px;">
                    <div class="profile-card">
                        <div class="profile-card-header">
                            <div class="profile-card-icon" style="background:rgba(59,130,246,0.1);color:#3b82f6;">
                                <i data-lucide="info" style="width:17px;height:17px;"></i>
                            </div>
                            <div>
                                <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);">Datos de Cuenta</h2>
                            </div>
                        </div>
                        <div class="profile-card-body" style="display:flex;flex-direction:column;gap:10px;">
                            @foreach (var (label, value) in new[]{
                                                        ("ID de usuario","KAI-00842"),
                                                        ("Miembro desde",Model.MemberSince),
                                                        ("Moneda base",Model.PreferredCurrency),
                                                        ("Último acceso","Hoy, 14:32")
                                                        })
                            {
                                <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-color);">
                                    <span style="font-size:0.78rem;color:var(--text-muted);">@label</span>
                                    <span style="font-size:0.78rem;font-weight:600;color:var(--text-main);font-family:'JetBrains Mono',monospace;">@value</span>
                                </div>
                            }
                            <button class="btn-secondary" type="button" style="margin-top:4px;">
                                <i data-lucide="download" style="width:13px;height:13px;"></i>
                                Exportar mis datos
                            </button>
                        </div>
                    </div>

                    <!-- Zona de peligro -->
                    <div class="profile-card" style="border-color:rgba(239,68,68,0.2);">
                        <div class="profile-card-header" style="border-color:rgba(239,68,68,0.15);">
                            <div class="profile-card-icon" style="background:rgba(239,68,68,0.1);color:#ef4444;">
                                <i data-lucide="alert-triangle" style="width:17px;height:17px;"></i>
                            </div>
                            <div>
                                <h2 style="font-size:0.92rem;font-weight:700;color:#ef4444;">Zona de Peligro</h2>
                                <p style="font-size:0.7rem;color:var(--text-muted);">Acciones irreversibles</p>
                            </div>
                        </div>
                        <div class="profile-card-body" style="display:flex;flex-direction:column;gap:10px;">
                            <p style="font-size:0.78rem;color:var(--text-muted);line-height:1.6;">
                                Al eliminar tu cuenta perderás todo tu historial, puntos KP, portafolio simulado y progreso en Academia. Esta acción <strong style="color:var(--text-main);">no se puede deshacer</strong>.
                            </p>
                            <button class="btn-danger" type="button" onclick="confirmDelete()">
                                <i data-lucide="trash-2" style="width:13px;height:13px;"></i>
                                Eliminar mi cuenta
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div><!-- /max-w -->
</div><!-- /bg-main -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // ── Fade in ──
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.k-fade').forEach((el, i) => {
                setTimeout(() => el.classList.add('visible'), 60 + i * 70);
            });
            setTimeout(() => {
                const fill = document.getElementById('riskFill');
                if (fill) fill.style.width = fill.dataset.target + '%';
            }, 400);
        });

        // ── Tabs ──
        function switchTab(btn, panelId) {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active');
                b.setAttribute('aria-selected','false');
            });
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));

            btn.classList.add('active');
            btn.setAttribute('aria-selected','true');

            const panel = document.getElementById(panelId);
            if (panel) {
                panel.classList.add('active');
                panel.style.animation = 'none';
                void panel.offsetWidth;
                panel.style.animation = '';
                panel.style.opacity = '0'; panel.style.transform = 'translateY(8px)';
                requestAnimationFrame(() => {
                    panel.style.transition = 'opacity 0.35s ease, transform 0.35s cubic-bezier(0.22,1,0.36,1)';
                    panel.style.opacity = '1'; panel.style.transform = 'translateY(0)';
                });
            }
        }

        // ── Toggle switch ──
        function toggleSwitch(track) {
            track.classList.toggle('on');
            const cb = track.closest('label')?.querySelector('.toggle-check');
            if (cb) cb.checked = track.classList.contains('on');

            track.style.transform = 'scale(0.93)';
            setTimeout(() => {
                track.style.transform = 'scale(1)';
                track.style.transition = 'transform 0.2s cubic-bezier(0.34,1.56,0.64,1)';
            }, 80);
        }

        // ── Password visibility ──
        function togglePw(id, btn) {
            const input = document.getElementById(id);
            if (!input) return;
            const isText = input.type === 'text';
            input.type = isText ? 'password' : 'text';
            btn.innerHTML = isText
                ? '<i data-lucide="eye" style="width:14px;height:14px;"></i>'
                : '<i data-lucide="eye-off" style="width:14px;height:14px;"></i>';
            lucide.createIcons();
        }

        // ── Password strength ──
        function evalStrength(input) {
            const val = input.value;
            const bars = document.querySelectorAll('#strengthBars .sb');
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 8)  score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const colors = ['','#ef4444','#f59e0b','#3b82f6','#10b981'];
            const labels = ['','Débil','Regular','Buena','Fuerte'];
            bars.forEach((bar, i) => {
                bar.style.background = i < score ? colors[score] : 'var(--border-color)';
            });
            if (label) {
                label.textContent = val.length ? labels[score] : '';
                label.style.color = colors[score];
            }
        }

        // ── Confirm delete ──
        function confirmDelete() {
            if (confirm('¿Estás seguro? Esta acción eliminará tu cuenta permanentemente.')) {
                // form submit
            }
        }

        // ── Avatar preview ──
        function previewAvatar(input) {
            const file = input.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                const ring = input.closest('.avatar-ring');
                if (!ring) return;
                ring.style.backgroundImage = `url(${e.target.result})`;
                ring.style.backgroundSize = 'cover';
                ring.style.fontSize = '0';
            };
            reader.readAsDataURL(file);
        }

        // ── Goal checkboxes visual ──
        document.querySelectorAll('[type="checkbox"]:not(.toggle-check)').forEach(cb => {
            cb.addEventListener('change', () => {
                const label = cb.closest('label');
                if (!label) return;
                // color extraído del estilo inline
                const icon = label.querySelector('i');
                const color = icon?.style.color || '#7c3aed';
                label.style.borderColor = cb.checked ? color : 'var(--border-color)';
            });
        });
    </script>
}
