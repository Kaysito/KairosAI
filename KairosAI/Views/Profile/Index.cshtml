@model KairosAI.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Fade orquestado ── */
    .k-fade {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22,1,0.36,1);
    }

        .k-fade.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ── Scroll ── */
    .scroll-h {
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
    }

        .scroll-h::-webkit-scrollbar {
            width: 4px;
        }

        .scroll-h::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

    /* ── Tabs ── */
    .profile-tabs {
        display: flex;
        gap: 4px;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: none;
    }

        .profile-tabs::-webkit-scrollbar {
            display: none;
        }

    .tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 10px;
        white-space: nowrap;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        transition: all 0.18s ease;
    }

        .tab-btn:hover {
            background: var(--hover-bg);
            color: var(--text-main);
        }

        .tab-btn.active {
            background: var(--bg-card);
            border-color: var(--border-color);
            color: var(--text-main);
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

    /* Tab panels */
    .tab-panel {
        display: none;
    }

        .tab-panel.active {
            display: block;
        }

    /* ── Section cards ── */
    .profile-card {
        border-radius: 18px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        overflow: hidden;
    }

    .profile-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .profile-card-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .profile-card-body {
        padding: 20px;
    }

    /* ── Form inputs ── */
    .k-input {
        width: 100%;
        padding: 11px 14px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: var(--bg-panel);
        color: var(--text-main);
        font-size: 0.875rem;
        transition: border-color 0.18s, box-shadow 0.18s;
        outline: none;
        font-family: inherit;
    }

        .k-input:focus {
            border-color: rgba(124,58,237,0.5);
            box-shadow: 0 0 0 3px rgba(124,58,237,0.07);
        }

        .k-input:hover {
            border-color: rgba(124,58,237,0.3);
        }

        .k-input::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }

    select.k-input {
        appearance: none;
        cursor: pointer;
    }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap .k-input {
            padding-left: 40px;
        }

        .input-icon-wrap .icon-left {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .input-icon-wrap .icon-right {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

    /* Label */
    .k-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 6px;
    }

    /* Required asterisk */
    .req {
        color: #ef4444;
    }

    /* ── Buttons ── */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 11px 22px;
        border-radius: 11px;
        background: #7c3aed;
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(124,58,237,0.25);
        transition: background 0.18s, box-shadow 0.18s, transform 0.18s cubic-bezier(0.34,1.56,0.64,1);
    }

        .btn-primary:hover {
            background: #6d28d9;
            box-shadow: 0 6px 20px rgba(124,58,237,0.35);
            transform: scale(1.02);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 11px 18px;
        border-radius: 11px;
        background: transparent;
        color: var(--text-main);
        font-size: 0.82rem;
        font-weight: 600;
        border: 1px solid var(--border-color);
        cursor: pointer;
        transition: border-color 0.18s, background 0.18s;
    }

        .btn-secondary:hover {
            border-color: rgba(124,58,237,0.4);
            background: var(--hover-bg);
        }

    .btn-danger {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        border-radius: 11px;
        background: rgba(239,68,68,0.08);
        color: #ef4444;
        font-size: 0.8rem;
        font-weight: 700;
        border: 1px solid rgba(239,68,68,0.2);
        cursor: pointer;
        transition: background 0.18s, border-color 0.18s;
    }

        .btn-danger:hover {
            background: rgba(239,68,68,0.14);
            border-color: rgba(239,68,68,0.4);
        }

    /* ── Toggle switch ── */
    .toggle-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        background: var(--bg-panel);
        transition: border-color 0.18s;
        cursor: pointer;
    }

        .toggle-wrap:hover {
            border-color: rgba(124,58,237,0.3);
        }

    .toggle-track {
        width: 40px;
        height: 22px;
        border-radius: 99px;
        background: var(--border-color);
        position: relative;
        transition: background 0.25s;
        flex-shrink: 0;
    }

        .toggle-track.on {
            background: #7c3aed;
        }

    .toggle-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1);
    }

    .toggle-track.on .toggle-thumb {
        transform: translateX(18px);
    }

    /* Hidden real checkbox */
    .toggle-check {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    /* ── Risk bar ── */
    .risk-track {
        height: 8px;
        border-radius: 99px;
        background: var(--border-color);
        overflow: hidden;
    }

    .risk-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg, #3b82f6, #7c3aed, #ec4899);
        transition: width 1.3s cubic-bezier(0.22,1,0.36,1);
    }

    /* ── Avatar upload ── */
    .avatar-ring {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #06b6d4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        font-family: 'JetBrains Mono', monospace;
        position: relative;
        flex-shrink: 0;
        border: 3px solid var(--bg-card);
        box-shadow: 0 0 0 2px rgba(124,58,237,0.3);
    }

    .avatar-edit-btn {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #7c3aed;
        border: 2px solid var(--bg-card);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1);
    }

    .avatar-ring:hover .avatar-edit-btn {
        transform: scale(1.15);
    }

    /* ── Stats strip ── */
    .stat-strip {
        display: flex;
        gap: 1px;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid var(--border-color);
    }

    .stat-cell {
        flex: 1;
        padding: 12px 14px;
        background: var(--bg-panel);
        text-align: center;
        min-width: 80px;
    }

        .stat-cell:not(:last-child) {
            border-right: 1px solid var(--border-color);
        }

    /* ── Notification item ── */
    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        background: var(--bg-panel);
        margin-bottom: 8px;
        transition: border-color 0.18s;
        cursor: pointer;
    }

        .notif-item:hover {
            border-color: rgba(124,58,237,0.3);
        }

        .notif-item:last-child {
            margin-bottom: 0;
        }

    /* ── Kairos AI insight block ── */
    .ai-insight {
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(124,58,237,0.06);
        border: 1px solid rgba(124,58,237,0.16);
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--text-muted);
    }

        .ai-insight strong {
            color: var(--text-main);
        }

    /* ── Activity timeline ── */
    .timeline-item {
        display: flex;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-color);
        position: relative;
    }

        .timeline-item:last-child {
            border-bottom: none;
        }

    .timeline-dot {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        margin-top: 1px;
    }

    /* ── Plan badge ── */
    .plan-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 99px;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.06em;
    }

    .plan-free {
        background: rgba(107,114,128,0.1);
        color: #9ca3af;
        border: 1px solid rgba(107,114,128,0.2);
    }

    .plan-pro {
        background: linear-gradient(135deg, rgba(124,58,237,0.12), rgba(6,182,212,0.08));
        color: #7c3aed;
        border: 1px solid rgba(124,58,237,0.2);
    }

    .plan-elite {
        background: linear-gradient(135deg, rgba(245,158,11,0.12), rgba(239,68,68,0.06));
        color: #f59e0b;
        border: 1px solid rgba(245,158,11,0.25);
    }

    /* ── Security indicator ── */
    .security-level {
        display: flex;
        gap: 3px;
        align-items: center;
    }

    .sec-bar {
        height: 5px;
        width: 28px;
        border-radius: 3px;
        background: var(--border-color);
        transition: background 0.3s;
    }

        .sec-bar.filled {
            background: #10b981;
        }

            .sec-bar.filled.med {
                background: #f59e0b;
            }

            .sec-bar.filled.low {
                background: #ef4444;
            }

    /* ── Alert banners ── */
    .alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 12px;
        font-size: 0.82rem;
        font-weight: 500;
        margin-bottom: 14px;
    }

    .alert-success {
        background: rgba(16,185,129,0.08);
        border: 1px solid rgba(16,185,129,0.2);
        color: #10b981;
    }

    .alert-error {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
        color: #ef4444;
    }

    .alert-info {
        background: rgba(59,130,246,0.08);
        border: 1px solid rgba(59,130,246,0.2);
        color: #3b82f6;
    }

    /* ── Responsive grid ── */
    @@media (max-width: 768px) {
        .profile-main-grid {
            grid-template-columns: 1fr !important;
        }
    }

    /* ── Section label ── */
    .section-label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        opacity: 0.7;
        margin-bottom: 10px;
    }
</style>

<div style="background:var(--bg-main);color:var(--text-main);min-height:100%;padding-bottom:60px;">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">

        <!-- ── ALERTS ── -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success k-fade">
                <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error k-fade">
                <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
                @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info k-fade">
                <i data-lucide="info" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
                @TempData["InfoMessage"]
            </div>
        }

        <!-- ── PROFILE HERO ── -->
        <div class="k-fade profile-card mb-6" style="overflow:visible;">
            <div style="padding:24px 24px 0;">
                <div style="display:flex;flex-wrap:wrap;align-items:flex-start;gap:16px;margin-bottom:20px;">

                    <!-- Avatar -->
                    <div class="avatar-ring">
                        KH
                        <label class="avatar-edit-btn" title="Cambiar foto" style="cursor:pointer;">
                            <i data-lucide="camera" style="width:11px;height:11px;color:#fff;"></i>
                            <input type="file" accept="image/*" style="display:none;" onchange="previewAvatar(this)">
                        </label>
                    </div>

                    <!-- Name + meta -->
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
                            <h1 style="font-size:1.25rem;font-weight:800;color:var(--text-main);">@Model.FullName</h1>
                            <span class="plan-badge plan-pro">
                                <i data-lucide="sparkles" style="width:10px;height:10px;"></i>
                                @Model.SubscriptionPlan
                            </span>
                        </div>
                        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:8px;">@Model.Email</p>
                        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                            <span style="font-size:0.68rem;color:var(--text-muted);display:flex;align-items:center;gap:4px;">
                                <i data-lucide="calendar" style="width:11px;height:11px;"></i>
                                Miembro desde @Model.MemberSince
                            </span>
                            <span style="font-size:0.68rem;color:#10b981;display:flex;align-items:center;gap:4px;font-family:'JetBrains Mono',monospace;">
                                <i data-lucide="shield-check" style="width:11px;height:11px;"></i>
                                Cuenta verificada
                            </span>
                        </div>
                    </div>

                    <!-- Security score -->
                    <div style="text-align:right;flex-shrink:0;">
                        <p style="font-size:0.6rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:5px;">Seguridad</p>
                        <div class="security-level" style="justify-content:flex-end;margin-bottom:4px;">
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar"></div>
                            <div class="sec-bar"></div>
                        </div>
                        <span style="font-size:0.62rem;color:var(--text-muted);">Buena</span>
                    </div>
                </div>
            </div>

            <!-- Stats strip -->
            <div class="stat-strip">
                <div class="stat-cell">
                    <p style="font-size:1rem;font-weight:800;color:var(--text-main);font-family:'JetBrains Mono',monospace;">@@Model.TotalPoints</p>
                    <p style="font-size:0.6rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.07em;margin-top:2px;">KP Ganados</p>
                </div>
                <div class="stat-cell">
                    <p style="font-size:1rem;font-weight:800;color:#10b981;font-family:'JetBrains Mono',monospace;">@Model.RiskScore<span style="font-size:0.6rem;color:var(--text-muted);">/100</span></p>
                    <p style="font-size:0.6rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.07em;margin-top:2px;">Índice Riesgo</p>
                </div>
                <div class="stat-cell">
                    <p style="font-size:1rem;font-weight:800;color:#7c3aed;font-family:'JetBrains Mono',monospace;">7</p>
                    <p style="font-size:0.6rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.07em;margin-top:2px;">Días Racha</p>
                </div>
                <div class="stat-cell">
                    <p style="font-size:1rem;font-weight:800;color:#f59e0b;font-family:'JetBrains Mono',monospace;">3</p>
                    <p style="font-size:0.6rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.07em;margin-top:2px;">Módulos ✓</p>
                </div>
            </div>
        </div>

        <!-- ── TABS ── -->
        <div class="profile-tabs k-fade mb-6" style="transition-delay:0.06s;" role="tablist">
            <button class="tab-btn active" onclick="switchTab(this,'tab-personal')" role="tab" aria-selected="true">
                <i data-lucide="user" style="width:14px;height:14px;"></i>Personal
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-riesgo')" role="tab" aria-selected="false">
                <i data-lucide="brain-circuit" style="width:14px;height:14px;"></i>Perfil IA
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-notif')" role="tab" aria-selected="false">
                <i data-lucide="bell" style="width:14px;height:14px;"></i>Notificaciones
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-seguridad')" role="tab" aria-selected="false">
                <i data-lucide="shield" style="width:14px;height:14px;"></i>Seguridad
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-cuenta')" role="tab" aria-selected="false">
                <i data-lucide="credit-card" style="width:14px;height:14px;"></i>Cuenta
            </button>
        </div>

        <!-- ══════════════════════════════════
             TAB 1: PERSONAL
        ══════════════════════════════════ -->
        <div id="tab-personal" class="tab-panel active k-fade" style="transition-delay:0.1s;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;" class="profile-main-grid">

                <!-- Información personal -->
                <div class="profile-card" style="grid-column:1/-1;">
                    <div class="profile-card-header">
                        <div class="profile-card-icon" style="background:rgba(124,58,237,0.1);color:#7c3aed;">
                            <i data-lucide="user-cog" style="width:17px;height:17px;"></i>
                        </div>
                        <div>
                            <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);">Información Personal</h2>
                            <p style="font-size:0.7rem;color:var(--text-muted);">Datos de contacto y preferencias de cuenta</p>
                        </div>
                    </div>

                    <div class="profile-card-body">
                        <form asp-action="Update" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;" class="profile-main-grid">
                                <div>
                                    <label class="k-label" for="FullName">Nombre completo <span class="req">*</span></label>
                                    <input asp-for="FullName" class="k-input" type="text" autocomplete="name" placeholder="Kevin Hernández" />
                                    <span asp-validation-for="FullName" style="color:#ef4444;font-size:0.72rem;margin-top:4px;display:block;"></span>
                                </div>
                                <div>
                                    <label class="k-label" for="Email">Correo electrónico <span class="req">*</span></label>
                                    <div class="input-icon-wrap">
                                        <i data-lucide="mail" class="icon-left" style="width:15px;height:15px;"></i>
                                        <input asp-for="Email" class="k-input" type="email" autocomplete="email" placeholder="kevin@ejemplo.com" />
                                    </div>
                                    <span asp-validation-for="Email" style="color:#ef4444;font-size:0.72rem;margin-top:4px;display:block;"></span>
                                </div>
                            </div>

                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;" class="profile-main-grid">
                                <div>
                                    <label class="k-label">Moneda base</label>
                                    <div class="input-icon-wrap">
                                        <i data-lucide="coins" class="icon-left" style="width:15px;height:15px;"></i>
                                        <select asp-for="PreferredCurrency" class="k-input" style="padding-left:40px;cursor:pointer;">
                                            <option value="MXN">🇲🇽 MXN - Peso Mexicano</option>
                                            <option value="USD">🇺🇸 USD - Dólar Estadounidense</option>
                                            <option value="EUR">🇪🇺 EUR - Euro</option>
                                            <option value="BTC">₿ BTC - Bitcoin</option>
                                        </select>
                                        <i data-lucide="chevron-down" class="icon-right" style="width:14px;height:14px;"></i>
                                    </div>
                                </div>
                                <div>
                                    <label class="k-label">Zona horaria</label>
                                    <div class="input-icon-wrap">
