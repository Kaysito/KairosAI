@model KairosAI.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Profile/Index.css" asp-append-version="true" />
}

<div class="profile-page-root">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success k-fade">
                <i data-lucide="check-circle" class="alert-inline-icon" aria-hidden="true"></i>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error k-fade">
                <i data-lucide="alert-circle" class="alert-inline-icon" aria-hidden="true"></i>
                @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info k-fade">
                <i data-lucide="info" class="alert-inline-icon" aria-hidden="true"></i>
                @TempData["InfoMessage"]
            </div>
        }

        <div class="k-fade profile-card mb-5">
            <div class="hero-inner-padding">
                <div class="hero-flex-container">

                    <div class="avatar-ring" aria-label="Avatar de Kevin H.">
                        KH
                        <label class="avatar-edit-btn" title="Cambiar foto de perfil" aria-label="Cambiar foto de perfil">
                            <i data-lucide="camera" class="camera-icon-style" aria-hidden="true"></i>
                            <input type="file" accept="image/*" class="input-file-hidden">
                        </label>
                    </div>

                    <div class="user-info-main">
                        <div class="name-badge-wrapper">
                            <h1 class="user-full-name">
                                Kevin Hernández Trejo
                            </h1>
                            <span class="plan-badge plan-pro">
                                <i data-lucide="sparkles" class="sparkle-icon-size" aria-hidden="true"></i>
                                @(Model?.SubscriptionPlan ?? "Pro Alpha")
                            </span>
                        </div>
                        <p class="user-email-display">
                            @(Model?.Email ?? "kevin@kairos.ai")
                        </p>
                        <div class="meta-data-flex">
                            <span class="meta-item-text">
                                <i data-lucide="calendar" class="meta-icon-size" aria-hidden="true"></i>
                                Miembro desde @(Model?.MemberSince ?? "enero 2025")
                            </span>
                            <span class="meta-item-text status-verified">
                                <i data-lucide="shield-check" class="meta-icon-size" aria-hidden="true"></i>
                                Cuenta verificada
                            </span>
                        </div>
                    </div>

                    <div class="security-meter-wrapper">
                        <p class="security-meter-label">Seguridad</p>
                        <div class="security-level security-align-right">
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar filled"></div>
                            <div class="sec-bar"></div>
                            <div class="sec-bar"></div>
                        </div>
                        <span class="security-score-text">Buena · 3/5</span>
                    </div>
                </div>
            </div>

            <div class="stat-strip" role="list" aria-label="Estadísticas de usuario">
                <div class="stat-cell" role="listitem">
                    <p class="stat-value-text">@(Model?.TotalPoints ?? 1240)</p>
                    <p class="stat-label-text">KP Ganados</p>
                </div>
                <div class="stat-cell" role="listitem">
                    <p class="stat-value-text risk-accent">
                        @(Model?.RiskScore ?? 62)<span class="stat-small-label">/100</span>
                    </p>
                    <p class="stat-label-text">Índice Riesgo</p>
                </div>
                <div class="stat-cell" role="listitem">
                    <p class="stat-value-text streak-accent">7</p>
                    <p class="stat-label-text">Días Racha</p>
                </div>
                <div class="stat-cell" role="listitem">
                    <p class="stat-value-text modules-accent">3</p>
                    <p class="stat-label-text">Módulos ✓</p>
                </div>
            </div>
        </div>

        <div class="profile-tabs k-fade mb-5 tab-delay-06" role="tablist">
            <button class="tab-btn active" onclick="switchTab(this,'tab-personal')"
                    role="tab" aria-selected="true" aria-controls="tab-personal">
                <i data-lucide="user" class="tab-icon-style" aria-hidden="true"></i>Personal
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-riesgo')"
                    role="tab" aria-selected="false" aria-controls="tab-riesgo">
                <i data-lucide="brain-circuit" class="tab-icon-style" aria-hidden="true"></i>Perfil IA
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-notif')"
                    role="tab" aria-selected="false" aria-controls="tab-notif">
                <i data-lucide="bell" class="tab-icon-style" aria-hidden="true"></i>Notificaciones
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-seguridad')"
                    role="tab" aria-selected="false" aria-controls="tab-seguridad">
                <i data-lucide="shield" class="tab-icon-style" aria-hidden="true"></i>Seguridad
            </button>
            <button class="tab-btn" onclick="switchTab(this,'tab-cuenta')"
                    role="tab" aria-selected="false" aria-controls="tab-cuenta">
                <i data-lucide="credit-card" class="tab-icon-style" aria-hidden="true"></i>Cuenta
            </button>
        </div>

        <div id="tab-personal" class="tab-panel active k-fade tab-delay-10"
             role="tabpanel" aria-labelledby="tab-personal">
            <div class="profile-grid-layout">
                <div class="profile-card col-span-all">
                    <div class="profile-card-header">
                        <div class="profile-card-icon personal-icon-bg">
                            <i data-lucide="user-cog" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Información Personal</h2>
                            <p class="card-subtitle-text">Datos de contacto y preferencias de cuenta</p>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <form asp-action="Update" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="form-grid-layout">
                                <div>
                                    <label class="k-label" for="FullName">Nombre completo <span class="req">*</span></label>
                                    <input asp-for="FullName" class="k-input" type="text" autocomplete="name"
                                           placeholder="Kevin Hernández Trejo" />
                                    <span asp-validation-for="FullName" class="form-validation-error"></span>
                                </div>
                                <div>
                                    <label class="k-label" for="Email">Correo electrónico <span class="req">*</span></label>
                                    <div class="input-icon-wrap">
                                        <i data-lucide="mail" class="icon-left input-icon-size" aria-hidden="true"></i>
                                        <input asp-for="Email" class="k-input" type="email"
                                               autocomplete="email" placeholder="kevin@kairos.ai" />
                                    </div>
                                    <span asp-validation-for="Email" class="form-validation-error"></span>
                                </div>
                            </div>
                            <div class="form-grid-layout">
                                <div>
                                    <label class="k-label">Moneda base</label>
                                    <div class="input-icon-wrap">
                                        <i data-lucide="coins" class="icon-left input-icon-size" aria-hidden="true"></i>
                                        <select asp-for="PreferredCurrency" class="k-input select-padding-left">
                                            <option value="MXN">🇲🇽 MXN — Peso Mexicano</option>
                                            <option value="USD">🇺🇸 USD — Dólar</option>
                                            <option value="EUR">🇪🇺 EUR — Euro</option>
                                            <option value="BTC">₿ BTC — Bitcoin</option>
                                        </select>
                                        <i data-lucide="chevron-down" class="icon-right dropdown-icon-size" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <div>
                                    <label class="k-label">Zona horaria</label>
                                    <div class="input-icon-wrap">
                                        <i data-lucide="globe" class="icon-left input-icon-size" aria-hidden="true"></i>
                                        <select class="k-input select-padding-left">
                                            <option>🇲🇽 América/México (GMT−6)</option>
                                            <option>🇺🇸 América/Nueva York (GMT−5)</option>
                                            <option>🇬🇧 Europa/Londres (GMT+0)</option>
                                        </select>
                                        <i data-lucide="chevron-down" class="icon-right dropdown-icon-size" aria-hidden="true"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="form-actions-footer">
                                <button type="submit" class="btn-primary">
                                    <i data-lucide="save" class="btn-icon-size" aria-hidden="true"></i>
                                    Guardar cambios
                                </button>
                                <button type="reset" class="btn-secondary">
                                    <i data-lucide="rotate-ccw" class="btn-icon-size" aria-hidden="true"></i>
                                    Restablecer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-riesgo" class="tab-panel k-fade tab-delay-10"
             role="tabpanel" aria-labelledby="tab-riesgo">
            <div class="profile-grid-layout">

                <div class="profile-card col-span-all">
                    <div class="profile-card-header shield-border-accent">
                        <div class="profile-card-icon shield-icon-bg">
                            <i data-lucide="shield" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Configuración de Intervención (Escudo)</h2>
                            <p class="card-subtitle-text">Decide cómo quieres que KairosAI interactúe con tus operaciones</p>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <label class="toggle-wrap toggle-premium-style">
                            <div class="toggle-text-container">
                                <p class="toggle-title">
                                    Activar Intervención en Tiempo Real
                                </p>
                                <p class="toggle-description">
                                    Permite que KairosAI actúe como tu guardián financiero. Si detectamos operaciones impulsivas guiadas por
                                    <strong class="text-emphasis">FOMO o FUD</strong>, pausaremos la transacción para darte una segunda opinión basada en datos reales.
                                </p>
                            </div>
                            <div class="toggle-track on" id="kairos-shield-toggle"
                                 onclick="handleShieldToggle(this)"
                                 role="switch" aria-checked="true" aria-label="Escudo KairosAI">
                                <div class="toggle-thumb"></div>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-header">
                        <div class="profile-card-icon brain-icon-bg">
                            <i data-lucide="brain-circuit" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Perfil de Riesgo KairosAI</h2>
                            <p class="card-subtitle-text">Calibrado con IA según tu comportamiento</p>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <div class="risk-score-display">
                            <div class="risk-label-group">
                                <p class="risk-main-label">
                                    @(Model?.RiskProfileLabel ?? "Moderado")
                                </p>
                                <p class="risk-desc-text">
                                    @(Model?.RiskProfileDescription ?? "Balance entre seguridad y rendimiento")
                                </p>
                            </div>
                            <div class="risk-number-badge">
                                <p class="risk-number-text">
                                    @(Model?.RiskScore ?? 62)
                                </p>
                                <p class="risk-max-text">/100</p>
                            </div>
                        </div>
                        <div class="risk-progress-section">
                            <div class="risk-track-labels">
                                <span>Conservador</span><span>Moderado</span><span>Agresivo</span>
                            </div>
                            <div class="risk-track">
                                <div class="risk-fill" id="riskFill"
                                     data-target="@(Model?.RiskScore ?? 62)"
                                     role="progressbar"
                                     aria-valuenow="@(Model?.RiskScore ?? 62)"
                                     aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        <form asp-action="RetakeTest" method="get" class="form-divider-top">
                            <button type="submit" class="btn-secondary btn-full-width">
                                <i data-lucide="clipboard-list" class="btn-icon-size" aria-hidden="true"></i>
                                Rehacer evaluación de riesgo
                            </button>
                        </form>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-header">
                        <div class="profile-card-icon ai-insight-icon-bg">
                            <i data-lucide="sparkles" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Análisis IA de Tu Perfil</h2>
                            <p class="card-subtitle-text">Exclusivo KairosAI · Actualizado hoy</p>
                        </div>
                    </div>
                    <div class="profile-card-body ai-insights-list">
                        <div class="ai-insight">
                            <div class="insight-header">
                                <i data-lucide="trending-up" class="insight-icon" aria-hidden="true"></i>
                                <strong class="insight-label">Patrón detectado</strong>
                            </div>
                            Tu historial muestra preferencia por <strong>activos de alta liquidez</strong>. KairosAI recomienda explorar ETFs de renta variable para diversificar sin salir de tu zona de confort.
                        </div>
                        <div class="ai-insight">
                            <div class="insight-header">
                                <i data-lucide="clock" class="insight-icon" aria-hidden="true"></i>
                                <strong class="insight-label">Comportamiento</strong>
                            </div>
                            Revisas tu portafolio en promedio <strong>2.3 veces al día</strong>. Los inversores con mejor rendimiento suelen revisar menos frecuentemente. Considera establecer alertas de precio.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-notif" class="tab-panel k-fade tab-delay-10"
             role="tabpanel" aria-labelledby="tab-notif">
            <div class="profile-card">
                <div class="profile-card-header">
                    <div class="profile-card-icon notif-icon-bg">
                        <i data-lucide="bell" class="icon-header-size" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="card-title-text">Centro de Notificaciones</h2>
                        <p class="card-subtitle-text">Controla qué te alertamos y cuándo</p>
                    </div>
                </div>
                <div class="profile-card-body">
                    <div class="notif-grid-layout">
                        <div>
                            <p class="section-label-style">Mercado y Portafolio</p>
                            @foreach (var (label, desc, def) in new[]{
                                                        ("Alertas de precio",    "Cuando un activo supere un umbral",   true),
                                                        ("Volatilidad extrema",  "Cambios >5% en menos de 1h",          true),
                                                        ("Resumen diario",       "Cierre del mercado con tu posición",   false),
                                                        ("Señales KairosAI",     "Recomendaciones personalizadas IA",    true)
                                                        })
                            {
                                <div class="notif-item">
                                    <div class="notif-text-content">
                                        <p class="notif-item-title">@label</p>
                                        <p class="notif-item-desc">@desc</p>
                                    </div>
                                    <div class="toggle-track @(def ? "on" : "")" onclick="toggleSwitch(this)"
                                         role="switch" aria-checked="@def.ToString().ToLower()" aria-label="@label">
                                        <div class="toggle-thumb"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div>
                            <p class="section-label-style">Academia y Plataforma</p>
                            @foreach (var (label, desc, def) in new[]{
                                                        ("Nuevo módulo",         "Cuando se publique contenido nuevo",   true),
                                                        ("Recordatorio racha",   "Si llevas 1 día sin actividad",        true),
                                                        ("Recompensas",          "Puntos suficientes para canjear",       false),
                                                        ("Noticias relevantes",  "Basadas en tu portafolio actual",      true)
                                                        })
                            {
                                <div class="notif-item">
                                    <div class="notif-text-content">
                                        <p class="notif-item-title">@label</p>
                                        <p class="notif-item-desc">@desc</p>
                                    </div>
                                    <div class="toggle-track @(def ? "on" : "")" onclick="toggleSwitch(this)"
                                         role="switch" aria-checked="@def.ToString().ToLower()" aria-label="@label">
                                        <div class="toggle-thumb"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-seguridad" class="tab-panel k-fade tab-delay-10"
             role="tabpanel" aria-labelledby="tab-seguridad">
            <div class="profile-grid-layout">
                <div class="profile-card">
                    <div class="profile-card-header">
                        <div class="profile-card-icon password-icon-bg">
                            <i data-lucide="lock" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Cambiar Contraseña</h2>
                            <p class="card-subtitle-text">Última actualización hace 30 días</p>
                        </div>
                    </div>
                    <div class="profile-card-body password-form-flex">
                        <div>
                            <label class="k-label" for="pwNew">Nueva contraseña <span class="req">*</span></label>
                            <div class="input-icon-wrap">
                                <i data-lucide="lock" class="icon-left input-icon-size" aria-hidden="true"></i>
                                <input type="password" class="k-input" placeholder="Mínimo 8 caracteres"
                                       id="pwNew" oninput="evalStrength(this)" autocomplete="new-password">
                            </div>
                            <div class="strength-bars-container" id="strengthBars" aria-hidden="true">
                                <div class="sb sb-base"></div>
                                <div class="sb sb-base"></div>
                                <div class="sb sb-base"></div>
                                <div class="sb sb-base"></div>
                            </div>
                            <p class="strength-label-text" id="strengthLabel" aria-live="polite"></p>
                        </div>
                        <button class="btn-primary" type="button">
                            <i data-lucide="key" class="btn-icon-size" aria-hidden="true"></i>
                            Actualizar contraseña
                        </button>
                    </div>
                </div>

                <div class="profile-card">
                    <div class="profile-card-header">
                        <div class="profile-card-icon tfa-icon-bg">
                            <i data-lucide="shield-check" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text">Autenticación 2FA</h2>
                            <p class="card-subtitle-text">Actualmente: desactivado</p>
                        </div>
                    </div>
                    <div class="profile-card-body">
                        <p class="tfa-info-text">
                            Agrega una capa extra de seguridad con Google Authenticator o SMS.
                        </p>
                        <button class="btn-primary tfa-active-btn" type="button">
                            <i data-lucide="shield-plus" class="btn-icon-size" aria-hidden="true"></i>
                            Activar 2FA
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-cuenta" class="tab-panel k-fade tab-delay-10"
             role="tabpanel" aria-labelledby="tab-cuenta">
            <div class="profile-grid-layout">
                <div class="profile-card danger-card-border">
                    <div class="profile-card-header danger-header-border">
                        <div class="profile-card-icon danger-icon-bg">
                            <i data-lucide="alert-triangle" class="icon-header-size" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="card-title-text text-danger">Zona de Peligro</h2>
                            <p class="card-subtitle-text">Acciones irreversibles</p>
                        </div>
                    </div>
                    <div class="profile-card-body danger-body-flex">
                        <p class="danger-info-text">
                            Al eliminar tu cuenta perderás todo tu historial, puntos KP, portafolio simulado y progreso en Academia.
                            Esta acción <strong class="text-emphasis">no se puede deshacer</strong>.
                        </p>
                        <button class="btn-danger" type="button" onclick="confirmDelete()">
                            <i data-lucide="trash-2" class="btn-icon-size" aria-hidden="true"></i>
                            Eliminar mi cuenta
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="legalModal" class="modal-overlay" role="dialog" aria-modal="true"
     aria-labelledby="shieldTitle" aria-describedby="shieldDesc">
    <div class="shield-modal">
        <div class="shield-stripe" aria-hidden="true"></div>
        <div class="shield-modal-body">
            <div class="shield-header">
                <div class="ring-wrap" aria-hidden="true">
                    <svg viewBox="0 0 56 56" width="56" height="56">
                        <circle class="ring-track" cx="28" cy="28" r="24" />
                        <circle class="ring-fill" id="ringFill" cx="28" cy="28" r="24" />
                    </svg>
                    <div class="ring-number" id="ringNumber">10</div>
                </div>
                <div class="shield-titles">
                    <h2 class="shield-title" id="shieldTitle">Deshabilitar Escudo KairosAI</h2>
                    <p class="shield-subtitle" id="shieldDesc">
                        Estás a punto de desactivar la protección en tiempo real. Lee con atención lo que implica esta decisión.
                    </p>
                </div>
            </div>
            <div class="shield-callout">
                <div class="shield-callout-icon" aria-hidden="true">
                    <i data-lucide="triangle-alert" class="alert-callout-size"></i>
                </div>
                <p>
                    Al confirmar, asumes <strong>responsabilidad total</strong> por pérdidas derivadas de volatilidad o decisiones impulsivas. KairosAI <strong>no podrá intervenir</strong> ni pausar tus operaciones.
                </p>
            </div>
            <div class="shield-timer-status" id="timerStatus" aria-live="polite" aria-atomic="true">
                <span class="timer-dot" id="timerDot" aria-hidden="true"></span>
                <span id="timerLabel">Revisando implicaciones — disponible en <strong id="timerSec">10</strong>s</span>
            </div>
        </div>
        <div class="shield-actions">
            <button class="btn-shield-cancel" onclick="cancelShieldDisable()" type="button">
                <i data-lucide="shield-check" class="btn-icon-size" aria-hidden="true"></i>
                Mantener Escudo
            </button>
            <button class="btn-shield-confirm" id="confirmDisableBtn"
                    onclick="confirmShieldDisable()" type="button"
                    disabled aria-disabled="true">
                <i data-lucide="shield-off" class="btn-icon-size" aria-hidden="true"></i>
                Acepto el Riesgo
            </button>
        </div>
    </div>
</div>

<div class="k-toast" id="kairos-toast" role="alert" aria-live="assertive" aria-atomic="true">
    <span id="toast-icon" aria-hidden="true"></span>
    <span id="toast-message"></span>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Profile/Index.js" asp-append-version="true"></script>
}