@model KairosAI.Models.ViewModels.NewsIndexViewModel
@{
    ViewData["Title"] = "Noticias - KairosAI";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ── Lógica de Kairós: Veredicto de Noticias ──
    int totalNews = Model.Headlines.Count();
    int positiveCount = Model.Headlines.Count(n => n.Sentiment == "Positivo");
    int negativeCount = Model.Headlines.Count(n => n.Sentiment == "Negativo");

    // Evitar división por cero si no hay noticias
    int positivePct = totalNews > 0 ? (int)Math.Round((double)positiveCount / totalNews * 100) : 0;
    int negativePct = totalNews > 0 ? (int)Math.Round((double)negativeCount / totalNews * 100) : 0;
    int neutralPct = totalNews > 0 ? 100 - positivePct - negativePct : 0;
}

<style>
    /* ── Variables locales ── */
    .news-page {
        background: var(--bg-main);
        color: var(--text-main);
    }

    /* ── Fade orquestado ── */
    .k-fade {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22,1,0.36,1);
    }

        .k-fade.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ── Header ── */
    .news-header {
        position: sticky;
        top: 0;
        z-index: 20;
        padding: 14px 0 12px;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        background: linear-gradient(to bottom, var(--bg-main) 80%, transparent);
    }

    /* ── Pill filter tabs ── */
    .filter-tabs {
        display: flex;
        gap: 6px;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-bottom: 2px;
    }

        .filter-tabs::-webkit-scrollbar {
            display: none;
        }

    .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 99px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        color: var(--text-muted);
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.18s ease;
        letter-spacing: 0.02em;
    }

        .filter-pill:hover {
            border-color: rgba(124,58,237,0.45);
            color: var(--text-main);
        }

        .filter-pill.active {
            background: #7c3aed;
            border-color: #7c3aed;
            color: #fff;
            box-shadow: 0 4px 14px rgba(124,58,237,0.3);
        }

    /* ── Live ticker ── */
    .live-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 99px;
        background: rgba(16,185,129,0.1);
        border: 1px solid rgba(16,185,129,0.25);
        font-size: 0.62rem;
        font-weight: 700;
        color: #10b981;
        letter-spacing: 0.1em;
        font-family: 'JetBrains Mono', monospace;
    }

    .live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        animation: livePulse 1.8s ease infinite;
    }

    @@keyframes livePulse {
        0%, 100% {
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(16,185,129,0.4);
        }

        50% {
            opacity: .7;
            box-shadow: 0 0 0 4px rgba(16,185,129,0);
        }
    }

    /* ── NUEVO: Kairós Market Verdict (Reemplazo de Fear/Greed) ── */
    .kairos-verdict-wrap {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 10px 14px;
        border-radius: 12px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        min-width: 240px;
    }

    .verdict-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .verdict-title {
        font-size: 0.62rem;
        font-weight: 800;
        color: var(--kairos-purple);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .verdict-track-container {
        display: flex;
        height: 6px;
        border-radius: 99px;
        overflow: hidden;
        background: var(--border-color); /* Fallback */
    }

    /* Las barras crecerán con JS para dar el efecto */
    .verdict-fill-pos {
        background: #10b981;
        transition: width 1s cubic-bezier(0.22,1,0.36,1);
        width: 0%;
    }

    .verdict-fill-neu {
        background: #9ca3af;
        transition: width 1s cubic-bezier(0.22,1,0.36,1);
        width: 0%;
        opacity: 0.5;
    }

    .verdict-fill-neg {
        background: #ef4444;
        transition: width 1s cubic-bezier(0.22,1,0.36,1);
        width: 0%;
    }

    /* ── FEATURED card (primera noticia grande) ── */
    .card-featured {
        grid-column: span 2;
        display: flex;
        flex-direction: column;
        border-radius: 18px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        overflow: hidden;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
        text-decoration: none;
        position: relative;
    }

    @@media (max-width: 900px) {
        .card-featured {
            grid-column: span 1;
        }
    }

    .card-featured:hover {
        border-color: rgba(124,58,237,0.5);
        box-shadow: 0 16px 40px rgba(124,58,237,0.1);
        transform: translateY(-2px);
    }

    /* ── STANDARD card ── */
    .card-news {
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        background: var(--bg-card);
        overflow: hidden;
        transition: border-color 0.2s, box-shadow 0.2s, transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
        text-decoration: none;
        position: relative;
    }

        .card-news:hover {
            border-color: rgba(124,58,237,0.45);
            box-shadow: 0 10px 30px rgba(124,58,237,0.08);
            transform: translateY(-2px);
        }

    /* Accent bar top */
    .card-accent-bar {
        height: 3px;
        background: linear-gradient(90deg, #7c3aed, #06b6d4);
        opacity: 0;
        transition: opacity 0.2s;
    }

    .card-news:hover .card-accent-bar,
    .card-featured:hover .card-accent-bar {
        opacity: 1;
    }

    /* Video embed */
    .video-wrapper {
        position: relative;
        width: 100%;
        padding-top: 56.25%;
        background: #000;
    }

        .video-wrapper iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

    /* ── Sentiment badge ── */
    .s-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border-radius: 99px;
        font-size: 0.65rem;
        font-weight: 700;
        border: 1px solid;
    }

        .s-badge.pos {
            background: rgba(16,185,129,0.1);
            border-color: rgba(16,185,129,0.25);
            color: #10b981;
        }

        .s-badge.neg {
            background: rgba(239,68,68,0.1);
            border-color: rgba(239,68,68,0.25);
            color: #ef4444;
        }

        .s-badge.neu {
            background: rgba(107,114,128,0.1);
            border-color: rgba(107,114,128,0.2);
            color: #9ca3af;
        }

    /* ── Source chip ── */
    .source-chip {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .source-avatar {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        font-weight: 700;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        flex-shrink: 0;
    }

    /* ── Category color map ── */
    .tag-cripto {
        background: rgba(245,158,11,0.1);
        color: #f59e0b;
    }

    .tag-forex {
        background: rgba(59,130,246,0.1);
        color: #3b82f6;
    }

    .tag-acciones {
        background: rgba(16,185,129,0.1);
        color: #10b981;
    }

    .tag-macro {
        background: rgba(124,58,237,0.1);
        color: #7c3aed;
    }

    .tag-default {
        background: rgba(107,114,128,0.1);
        color: #9ca3af;
    }

    .category-tag {
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* ── Empty state ── */
    .empty-state {
        grid-column: 1/-1;
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
    }

    /* ── Kairos insight chip ── */
    .kairos-insight {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 10px;
        background: rgba(124,58,237,0.06);
        border: 1px solid rgba(124,58,237,0.15);
        font-size: 0.72rem;
        color: var(--text-muted);
        line-height: 1.45;
        margin-top: 10px;
    }

        .kairos-insight i {
            flex-shrink: 0;
            margin-top: 1px;
            color: #7c3aed;
        }
</style>

<div class="news-page h-full overflow-y-auto" style="padding: 0 0 60px;">

    <div class="news-header px-5 sm:px-8">
        <div class="max-w-7xl mx-auto">

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 k-fade">
                <div class="flex items-center gap-3">
                    <div style="padding:8px;background:rgba(124,58,237,0.1);border-radius:10px;">
                        <i data-lucide="newspaper" style="width:18px;height:18px;color:#7c3aed;"></i>
                    </div>
                    <div>
                        <h1 style="font-size:1.15rem;font-weight:700;color:var(--text-main);line-height:1.2;">
                            Inteligencia de Mercado
                        </h1>
                        <p style="font-size:0.7rem;color:var(--text-muted);">
                            Sentimiento, señales y análisis filtrado por IA
                        </p>
                    </div>
                    <div class="live-badge hidden sm:inline-flex">
                        <div class="live-dot"></div>
                        LIVE
                    </div>
                </div>

                <div class="kairos-verdict-wrap k-fade" style="transition-delay:0.1s;" title="Porcentaje de impacto de las noticias analizadas">
                    <div class="verdict-header">
                        <span class="verdict-title">
                            <i data-lucide="brain-circuit" style="width:12px;height:12px;"></i>
                            Veredicto KairósAI
                        </span>
                        <div style="display:flex; gap:8px; font-family:'JetBrains Mono',monospace; font-size:0.58rem; font-weight:700;">
                            <span style="color:#10b981;">+@positivePct%</span>
                            <span style="color:var(--text-muted);">@neutralPct%</span>
                            <span style="color:#ef4444;">-@negativePct%</span>
                        </div>
                    </div>
                    <div class="verdict-track-container">
                        <div class="verdict-fill-pos" id="fillPos" data-target="@positivePct"></div>
                        <div class="verdict-fill-neu" id="fillNeu" data-target="@neutralPct"></div>
                        <div class="verdict-fill-neg" id="fillNeg" data-target="@negativePct"></div>
                    </div>
                </div>
            </div>

            <div class="filter-tabs k-fade" style="transition-delay:0.15s;" role="tablist" aria-label="Filtrar noticias">
                <button class="filter-pill active" onclick="filterNews(this,'todo')" role="tab" aria-selected="true">
                    <i data-lucide="layout-grid" style="width:12px;height:12px;"></i>
                    Todo
                </button>
                <button class="filter-pill" onclick="filterNews(this,'cripto')" role="tab" aria-selected="false">
                    <i data-lucide="bitcoin" style="width:12px;height:12px;"></i>
                    Cripto
                </button>
                <button class="filter-pill" onclick="filterNews(this,'forex')" role="tab" aria-selected="false">
                    <i data-lucide="dollar-sign" style="width:12px;height:12px;"></i>
                    Forex
                </button>
                <button class="filter-pill" onclick="filterNews(this,'acciones')" role="tab" aria-selected="false">
                    <i data-lucide="trending-up" style="width:12px;height:12px;"></i>
                    Acciones
                </button>
                <button class="filter-pill" onclick="filterNews(this,'macro')" role="tab" aria-selected="false">
                    <i data-lucide="globe" style="width:12px;height:12px;"></i>
                    Macro
                </button>
                <button class="filter-pill" onclick="filterNews(this,'video')" role="tab" aria-selected="false">
                    <i data-lucide="youtube" style="width:12px;height:12px;"></i>
                    Videos
                </button>
            </div>
        </div>
    </div>

    <div class="px-5 sm:px-8 mt-6">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 k-fade" style="transition-delay:0.2s;" id="newsGrid">

                @if (!Model.Headlines.Any())
                {
                    <div class="empty-state">
                        <i data-lucide="inbox" style="width:40px;height:40px;margin:0 auto 12px;opacity:0.3;"></i>
                        <p style="font-size:0.9rem;">No hay noticias disponibles por ahora.</p>
                    </div>
                }

                @{
                    bool isFirst = true;
                }

                @foreach (var item in Model.Headlines)
                {
                    var sClass = item.Sentiment switch
                    {
                        "Positivo" => "pos",
                        "Negativo" => "neg",
                        _ => "neu"
                    };
                    var sIcon = item.Sentiment switch
                    {
                        "Positivo" => "trending-up",
                        "Negativo" => "trending-down",
                        _ => "minus"
                    };

                    // Category detection (simple heuristic — reemplaza con tu campo real)
                    string cat = "default";
                    string catLabel = "General";
                    var titleLower = item.Title.ToLower();
                    if (titleLower.Contains("bitcoin") || titleLower.Contains("eth") || titleLower.Contains("crypto") || titleLower.Contains("cripto") || titleLower.Contains("defi"))
                    { cat = "cripto"; catLabel = "Cripto"; }
                    else if (titleLower.Contains("dólar") || titleLower.Contains("euro") || titleLower.Contains("forex") || titleLower.Contains("divisa"))
                    { cat = "forex"; catLabel = "Forex"; }
                    else if (titleLower.Contains("bolsa") || titleLower.Contains("acción") || titleLower.Contains("nasdaq") || titleLower.Contains("s&p"))
                    { cat = "acciones"; catLabel = "Acciones"; }
                    else if (titleLower.Contains("fed") || titleLower.Contains("inflación") || titleLower.Contains("pib") || titleLower.Contains("macro"))
                    { cat = "macro"; catLabel = "Macro"; }

                    // Video detection
                    string videoId = "";
                    if (item.Title.Contains("Video") || item.Title.Contains("Análisis"))
                    {
                        videoId = "plz-8Z8GzK8";
                        cat = "video"; catLabel = "Video";
                    }

                    string externalLink = "#"; // item.Url

                    if (isFirst)
                    {
                        isFirst = false;
                        <article class="card-featured" data-category="@cat">
                            <div class="card-accent-bar"></div>

                            @if (!string.IsNullOrEmpty(videoId))
                            {
                                <div class="video-wrapper">
                                    <iframe src="https://www.youtube.com/embed/@videoId"
                                            title="@item.Title" frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen loading="lazy"></iframe>
                                </div>
                            }
                            else
                            {
                                <div style="height:180px;background:linear-gradient(135deg,rgba(124,58,237,0.12) 0%,rgba(6,182,212,0.06) 100%);display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--border-color);position:relative;overflow:hidden;">
                                    <div style="position:absolute;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,0.15),transparent 70%);top:-40px;left:-40px;"></div>
                                    <div style="position:absolute;width:150px;height:150px;border-radius:50%;background:radial-gradient(circle,rgba(6,182,212,0.1),transparent 70%);bottom:-30px;right:20px;"></div>
                                    <div style="text-align:center;position:relative;z-index:1;">
                                        <i data-lucide="newspaper" style="width:36px;height:36px;color:rgba(124,58,237,0.4);margin:0 auto 8px;display:block;"></i>
                                        <span style="font-size:0.65rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;letter-spacing:0.1em;">ANÁLISIS DESTACADO</span>
                                    </div>
                                </div>
                            }

                            <div style="padding:20px;display:flex;flex-direction:column;flex:1;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:6px;">
                                    <div style="display:flex;align-items:center;gap:6px;">
                                        <span class="s-badge @sClass">
                                            <i data-lucide="@sIcon" style="width:10px;height:10px;"></i>
                                            @item.Sentiment
                                        </span>
                                        <span class="category-tag tag-@cat">@catLabel</span>
                                    </div>
                                    <span style="font-size:0.65rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:4px;">
                                        <i data-lucide="clock" style="width:11px;height:11px;"></i>
                                        @item.TimeAgo
                                    </span>
                                </div>

                                <h2 style="font-size:1.05rem;font-weight:700;color:var(--text-main);line-height:1.35;margin-bottom:8px;">
                                    @item.Title
                                </h2>
                                <p style="font-size:0.82rem;color:var(--text-muted);line-height:1.6;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;flex:1;">
                                    @item.Summary
                                </p>

                                <div class="kairos-insight">
                                    <i data-lucide="sparkles" style="width:13px;height:13px;"></i>
                                    <span>KairosAI detecta señal <strong style="color:var(--text-main);">@item.Sentiment.ToLower()</strong> en este artículo. Puede impactar activos relacionados en las próximas 24h.</span>
                                </div>

                                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:14px;padding-top:12px;border-top:1px solid var(--border-color);">
                                    <div class="source-chip">
                                        <div class="source-avatar">@item.Source.Substring(0, 1)</div>
                                        <span style="font-size:0.75rem;font-weight:600;color:var(--text-main);">@item.Source</span>
                                    </div>
                                    <a href="@externalLink" target="_blank"
                                       style="font-size:0.75rem;font-weight:700;color:#7c3aed;text-decoration:none;display:flex;align-items:center;gap:4px;transition:opacity 0.15s;"
                                       onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                                        Leer análisis completo
                                        <i data-lucide="arrow-up-right" style="width:13px;height:13px;"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                    else
                    {
                        <article class="card-news" data-category="@cat">
                            <div class="card-accent-bar"></div>

                            @if (!string.IsNullOrEmpty(videoId))
                            {
                                <div class="video-wrapper">
                                    <iframe src="https://www.youtube.com/embed/@videoId"
                                            title="@item.Title" frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen loading="lazy"></iframe>
                                </div>
                            }

                            <div style="padding:16px;display:flex;flex-direction:column;flex:1;">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;gap:6px;flex-wrap:wrap;">
                                    <div style="display:flex;align-items:center;gap:5px;">
                                        <span class="s-badge @sClass">
                                            <i data-lucide="@sIcon" style="width:10px;height:10px;"></i>
                                            @item.Sentiment
                                        </span>
                                        <span class="category-tag tag-@cat">@catLabel</span>
                                    </div>
                                    <span style="font-size:0.62rem;color:var(--text-muted);font-family:'JetBrains Mono',monospace;display:flex;align-items:center;gap:3px;">
                                        <i data-lucide="clock" style="width:10px;height:10px;"></i>
                                        @item.TimeAgo
                                    </span>
                                </div>

                                <h2 style="font-size:0.92rem;font-weight:700;color:var(--text-main);line-height:1.4;margin-bottom:7px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                    @item.Title
                                </h2>
                                <p style="font-size:0.78rem;color:var(--text-muted);line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;flex:1;margin-bottom:12px;">
                                    @item.Summary
                                </p>

                                <div style="display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid var(--border-color);">
                                    <div class="source-chip">
                                        <div class="source-avatar">@item.Source.Substring(0, 1)</div>
                                        <span style="font-size:0.72rem;font-weight:600;color:var(--text-main);">@item.Source</span>
                                    </div>
                                    <a href="@externalLink" target="_blank"
                                       style="font-size:0.7rem;font-weight:700;color:#7c3aed;text-decoration:none;display:flex;align-items:center;gap:3px;transition:opacity 0.15s;"
                                       onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                                        Leer nota
                                        <i data-lucide="external-link" style="width:11px;height:11px;"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // ── Fade inicial y Veredicto Kairós ──
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.k-fade').forEach((el, i) => {
                setTimeout(() => el.classList.add('visible'), 60 + i * 80);
            });

            // Animación de las barras del veredicto
            setTimeout(() => {
                const fillPos = document.getElementById('fillPos');
                const fillNeu = document.getElementById('fillNeu');
                const fillNeg = document.getElementById('fillNeg');

                if (fillPos) fillPos.style.width = fillPos.dataset.target + '%';
                if (fillNeu) fillNeu.style.width = fillNeu.dataset.target + '%';
                if (fillNeg) fillNeg.style.width = fillNeg.dataset.target + '%';
            }, 400);
        });

        // ── Filter tabs ──
        function filterNews(btn, category) {
            // Pill activa
            document.querySelectorAll('.filter-pill').forEach(p => {
                p.classList.remove('active');
                p.setAttribute('aria-selected', 'false');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-selected', 'true');

            // Filtrar cards
            const cards = document.querySelectorAll('#newsGrid article');
            cards.forEach(card => {
                const match = category === 'todo' || card.dataset.category === category;
                card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
                if (match) {
                    card.style.opacity = '1';
                    card.style.transform = 'scale(1)';
                    card.style.pointerEvents = 'auto';
                    card.style.display = '';
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.97)';
                    card.style.pointerEvents = 'none';
                    setTimeout(() => {
                        if (card.style.opacity === '0') card.style.display = 'none';
                    }, 250);
                }
            });
        }
    </script>
}